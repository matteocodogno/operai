generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────
//
// Native Prisma enums (departing from estimai-api/notify-api's "String +
// zod-boundary validation" convention — see plan.md § Data model) because
// this domain's closed sets are genuinely fixed by the spec/plan (the twelve
// expense types, the four-state lifecycle, the two wellD legal entities, the
// five audit actions, the two-phase upload status) and Postgres-level enum
// constraints add a second, DB-native line of defense for financial data —
// consistent with this plan's overall "defense in depth" posture (ADR 20260716-immutable-financial-audit-trail-refund).

// draft|submitted|approved|rejected|paid. `withdrawn` is NOT a status — it is
// an AuditAction recording the submitted→draft transition (Gate-2 D1,
// plan.md Risk R6).
//
// `paid` (specs/20260719-refund-monthly-processing, ADR 20260719-refund-batch-paid-lifecycle-extension) is a fifth, terminal
// value — it SUPERSEDES the original 007 "do not add a fifth value here"
// freeze (that freeze was never given its own ADR; ADR 20260719-refund-batch-paid-lifecycle-extension is the canonical
// record of why it no longer holds). `paid` inherits every existing
// mutation guard for free: 007's edit/delete/decide guards gate on
// `status == 'draft'` or `status == 'submitted'` only — `paid` is neither,
// so it is exactly as immutable as `approved`/`rejected` with zero guard
// changes (verified against lines.repo/lifecycle.repo/decide.repo).
enum RefundStatus {
  draft
  submitted
  approved
  rejected
  paid
}

// Compiled-batch lifecycle (specs/20260719-refund-monthly-processing, ADR 20260719-refund-batch-paid-lifecycle-extension).
// Exactly three values, each reached at most once per batch, both exits
// (paid, discarded) are terminal and mutually exclusive (compare-and-swap
// on `status='compiled'` — see RefundBatch below).
enum BatchStatus {
  compiled
  paid
  discarded
}

// Reuses auth's `user.entity` string values verbatim (welld_it | welld_ch).
// Currency used to be DERIVED from this — as of the 2026-07-17 amendment
// (plan.md § Money handling) currency is an INDEPENDENTLY-STORED per-line
// field (see `Currency` below): any (entity, currency) combination is valid,
// so this enum no longer implies a currency.
enum Entity {
  welld_it
  welld_ch
}

// Independently-stored per-line currency (2026-07-17 amendment — reverses
// the original "derived from entity, never stored" decision, plan.md §
// Money handling). Records what was ACTUALLY paid in, which may differ from
// the entity's "home" currency (e.g. a welld_it line paid in CHF or USD).
// Never constrained by `entity` at the DB or API level.
enum Currency {
  EUR
  CHF
  USD
  GBP
}

// The twelve expense types from the spec's line-item table. `km` (RefundLine)
// is required and >0 iff type == travel_km, rejected for every other type
// (AC-1.2).
enum ExpenseType {
  travel_highway
  travel_km
  travel_parking
  travel_train
  travel_other_public_transport
  company_manuals
  stationery
  representation_meals
  representation_gifts
  office_material
  postal
  telephone
}

// One row per audited state-relevant event (US-8, ADR 20260716-immutable-financial-audit-trail-refund). Written inside
// the same transaction as the event it records.
//
// batch_compiled|batch_paid|batch_discarded (specs/20260719-refund-monthly-processing,
// ADR 20260719-refund-batch-paid-lifecycle-extension/0022) extend this in place — one row per affected request per
// batch action, `batchId` set on these three only (see RefundAuditEntry
// below). No new table, no new trigger: the existing ADR 20260716-immutable-financial-audit-trail-refund immutability
// trigger applies to these rows unchanged.
enum AuditAction {
  submitted
  withdrawn
  approved
  rejected
  approved_total_set
  // A reviewer rejected ONE line (with a mandatory reason) or took that
  // rejection back while the request was still `submitted` — lineId set,
  // detail { reason } / { reason } of the rejection being withdrawn.
  line_rejected
  line_restored
  batch_compiled
  batch_paid
  batch_discarded
  // specs/20261118-refund-accounting-export: both carry `lineId`, written in
  // the same transaction as the event they record (classification freeze or
  // change; receipt number assignment). Detail shapes: plan.md § Data model.
  line_classified
  receipt_number_assigned
  // specs/20261119-accounting (T16): a pending exchange-rate copy written by
  // the first successful export of a batch (actor = the exporter, AC-5.6).
  // Added last in the migration and not used inside it.
  line_rate_copied
}

// Origin of one exchange-rate row (specs/20261118-refund-accounting-export):
// `fetched` is read from the federal source and recorded once, `corrected` is
// an admin's append-only correction. The rate in effect is the latest
// `corrected` row, else the `fetched` one.
enum ExchangeRateOrigin {
  fetched
  corrected
}

// Two-phase presigned upload (ADR 20260716-eu-object-storage-refund-attachments, wired by T9): `pending` until the
// browser's direct-to-bucket upload is confirmed via HEAD, then `stored`.
// Only `stored` attachments are ever surfaced by refund-api's own routes.
enum UploadStatus {
  pending
  stored
}

// ─── Models ─────────────────────────────────────────────────────────────────

// RefundRequest — the top-level expense-reimbursement document (T5,
// specs/20260716-refund-service, plan.md § Data model).
//
// ownerUserId is the JWT `sub` (ADR 20260703-jwt-resource-server-remote-jwks pattern) — NEVER taken from the
// request body; every query is scoped to it (employee-owned) or to the
// entity-scope predicate (accounting review, ADR 20260716-entity-scoped-abac-refund-api). ownerEmail/ownerName
// are snapshots taken at creation time for accounting display (AC-6.1) — this
// service holds no `User` table (users live only in the `auth` DB), mirroring
// estimai-api/notify-api's sub-as-foreign-key-less-ownership convention.
//
// A request has NO single entity — its lines may straddle both welld_it and
// welld_ch (AC-3.5/6.6) — so entity scoping is evaluated per-request via "at
// least one line matches" (ADR 20260716-entity-scoped-abac-refund-api), never via a column on this table.
model RefundRequest {
  id                  String       @id @default(cuid())
  ownerUserId         String
  ownerEmail          String
  ownerName           String?
  status              RefundStatus @default(draft)
  submittedAt         DateTime?
  decidedAt           DateTime?
  decidedByUserId     String?
  decidedByEmail      String?
  // Display-name SNAPSHOT of the deciding accounting user, taken at decision
  // time — the same posture as `ownerName` above, and for the same reason: a
  // document a human files should lead with the human, and re-resolving the
  // name later would make an archived PDF's contents depend on whether that
  // person still exists. Nullable because rows decided before this column
  // existed have no name to recover; those fall back to the email.
  decidedByName       String?
  // Non-null iff status == rejected (AC-7.3); left null/untouched otherwise.
  rejectionMotivation String?
  // LIVE batch claim pointer (specs/20260719-refund-monthly-processing, ADR 20260719-refund-batch-paid-lifecycle-extension).
  // NULL = eligible for a future compile; non-null = currently claimed by a
  // `compiled` or `paid` RefundBatch. Nulled on discard (released back to
  // the candidate pool) and overwritable by a later batch once released —
  // this field is NOT the permanent membership record (see RefundBatchItem
  // for that). onDelete: Restrict — a claimed request cannot be deleted out
  // from under its batch.
  batchId             String?
  batch               RefundBatch? @relation(fields: [batchId], references: [id], onDelete: Restrict)

  lines        RefundLine[]
  auditEntries RefundAuditEntry[]
  batchItems   RefundBatchItem[]  @relation("BatchItemRequest")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerUserId, status]) // list-own (AC-3.1)
  @@index([status]) // queue base filter (AC-5.1), combined with the line entity join at query time
  @@index([status, batchId, decidedAt]) // candidate query: approved ∧ batchId NULL ∧ decidedAt<=cutoff (specs/20260719-refund-monthly-processing AC-1.2)
  @@map("refund_request")
}

// RefundBatch — a compiled run: a frozen set of `approved` requests as of a
// chosen cutoff, tied to one generated PDF (specs/20260719-refund-monthly-processing,
// ADR 20260719-refund-batch-pdf-generation-pdf-lib/0020). Never mutated in place beyond its own terminal-once status
// transition and the email/paid/discarded provenance fields below.
model RefundBatch {
  id                     String      @id @default(cuid())
  cutoff                 DateTime // AC-1.1 (defaults to now if not overridden — applied in the handler, not a DB default)
  status                 BatchStatus @default(compiled)
  createdByUserId        String // generating accounting user (AC-1.6 header)
  createdByEmail         String
  // refund/batches/{id}/compiled.pdf — no PII in the key (ADR 20260719-refund-batch-pdf-generation-pdf-lib).
  pdfObjectKey           String      @unique
  // specs/20260722-refund-settings, ADR 20260722-batch-email-recipient-live-resolution-amends-0021 — AMENDS ADR 20260719-refund-batch-signed-link-email-delivery: this used to be
  // the configured distribution address captured (frozen) at compile time;
  // it is now nullable, per-attempt delivery PROVENANCE ONLY — "the address
  // the last send/resend attempt targeted" — never the source of truth for
  // where to send. The live `accounting-distribution-email` refund_setting
  // (src/settings/) is resolved fresh at every send/resend instead (D6).
  // Null until the first send/resend attempt (including when that attempt
  // is blocked because the setting is unconfigured — see emailStatus below).
  recipientEmailSnapshot String?
  // Compilation-email delivery status surfaced in-app (AC-3.2), updated on
  // send/resend. "sent" | "failed" | "blocked_unconfigured" | null (never
  // attempted) — validated at the application boundary, not a DB enum
  // (mirrors notify-api's own delivery-status convention). The third value
  // (specs/20260722-refund-settings, ADR 20260722-batch-email-recipient-live-resolution-amends-0021) marks a send/resend attempt that
  // never reached notify-api because the accounting-distribution-email
  // setting was unconfigured — distinguishable from an ordinary "failed"
  // notify-api/Resend outage.
  emailStatus            String?
  emailLastAttemptAt     DateTime?
  emailDeliveryId        String? // notify-api EmailDelivery id, for support tracing
  // Terminal-transition provenance (the audit trail is the authoritative
  // record of *that* it happened — these back the AC-2.1/AC-6.1 in-app
  // display without a join).
  paidAt                 DateTime?
  paidByEmail            String?
  discardedAt            DateTime?
  discardedByEmail       String?

  items        RefundBatchItem[]
  requests     RefundRequest[] // live "currently claimed by" pointer (nulled on discard)
  auditEntries RefundAuditEntry[]
  exports      RefundBatchExport[] // append-only accounting-export log (specs/20261118-refund-accounting-export, AC-6.10)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt]) // history list (AC-8.1/8.2)
  @@map("refund_batch")
}

// RefundBatchItem — immutable membership snapshot (specs/20260719-refund-monthly-processing,
// ADR 20260719-refund-batch-paid-lifecycle-extension). Records that a request was ONCE in a batch, kept forever even
// after discard and even if the request is later re-included in a different
// batch (AC-6.3, AC-7.3). This — NOT RefundRequest.batchId — is the durable
// membership of record and the input ADR 20260719-refund-batch-pdf-generation-pdf-lib's PDF renderer reads from, so
// a discarded batch's PDF still resolves (AC-1.10/6.3). onDelete: Restrict
// on both FKs — never deleted, and makes a once-batched request/batch
// physically undeletable.
model RefundBatchItem {
  id        String        @id @default(cuid())
  batchId   String
  batch     RefundBatch   @relation(fields: [batchId], references: [id], onDelete: Restrict)
  requestId String
  request   RefundRequest @relation("BatchItemRequest", fields: [requestId], references: [id], onDelete: Restrict)
  createdAt DateTime      @default(now())

  @@unique([batchId, requestId]) // a request appears once per batch
  @@index([requestId]) // AC-7.3 "which batches has this request ever been in"
  @@map("refund_batch_item")
}

// RefundLine — a single expense-line item, entity-scoped individually
// (T5, plan.md § Data model).
//
// requestedAmountCents is employee-entered (AC-1.2); approvedTotalCents is
// set during accounting review (AC-7.1/7.2), defaulting to
// requestedAmountCents on approve for any line left untouched (application
// logic, T12 — not a DB default, since "untouched" must be distinguishable
// from "explicitly set to the same value" during review).
//
// Money is stored as integer minor units (cents/centesimi), never Decimal or
// float — exact, unambiguous, trivially summable for per-currency subtotals
// (plan.md § Money handling). Currency is an INDEPENDENTLY-STORED field
// (2026-07-17 amendment — reverses the original "derived from entity, never
// stored" decision) — it records what was actually paid in, decoupled from
// `entity`; any (entity, currency) combination is valid, and subtotals now
// group purely by the stored `currency`, never by entity.
//
// specs/20260720-mileage-rate amendment: for `type == travel_km` lines ONLY,
// `currency` is forced server-side from `entity` (welld_ch→CHF, welld_it→EUR)
// rather than independently chosen — see appliedRate* below and
// requests/lines.repo.ts. Every other type's currency field is unaffected.
model RefundLine {
  id        String        @id @default(cuid())
  requestId String
  request   RefundRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  date                 DateTime    @db.Date
  type                 ExpenseType
  motivo               String
  entity               Entity
  currency             Currency
  requestedAmountCents Int
  // Required and > 0 iff type == travel_km; rejected (422) if present for any
  // other type (AC-1.2/1.6). Nullable at the DB level — validated at the API
  // boundary, not by a CHECK constraint, so the same table shape serves every
  // expense type without a partial/conditional column.
  km                   Int?
  approvedTotalCents   Int?

  // ─── Line rejection (specs/20260716-refund-service amendment, 2026-11-10) ───────────────────
  // A reviewer may refuse ONE line instead of the whole request. Non-null
  // `rejectionReason` IS the rejected state (all four set together, cleared
  // together on restore or withdraw-to-draft); a rejected line's
  // `approvedTotalCents` is 0, so every existing consumer of the approved
  // figure (subtotals, batch PDF, export, email) already pays nothing for it.
  rejectionReason  String?
  rejectedAt       DateTime?
  rejectedByUserId String?
  rejectedByEmail  String?

  // ─── specs/20260720-mileage-rate: applied-rate snapshot (Decision 1) ──────────
  // All three are non-null ONLY once this line's containing request has ever
  // reached `submitted` AND it is currently frozen — written together inside
  // the submit transaction (lifecycle.repo.ts), cleared together back to null
  // on withdraw-to-draft (AC-3.1/3.2). Null for: a draft/never-submitted
  // travel_km line (live/derived-on-read, ADR 20260714-invitation-lifecycle-derived-expiry-state), any non-travel_km line,
  // and a legacy pre-feature submitted travel_km line (AC-1.7, this
  // migration never backfills). onDelete: Restrict — a MileageRate a line
  // references can never be deleted (and MileageRate rows are never deleted
  // anyway — append-only, AC-4.7).
  appliedRateMicros    Int?
  appliedRateValidFrom DateTime?    @db.Date
  appliedRateEntryId   String?
  appliedRate          MileageRate? @relation(fields: [appliedRateEntryId], references: [id], onDelete: Restrict)

  // ─── specs/20261118-refund-accounting-export: accounting classification ───────────────────
  // WellD CH lines only. Before approval: null = follow the live default,
  // non-null = an accounting override. Frozen (both ids and both flags set)
  // at approval for every non-rejected WellD CH line. Immutable once the
  // parent request is `paid` (trigger refund_line_accounting_guard, AC-3.7).
  // onDelete: Restrict, an account or VAT code a line references can never
  // be deleted (and catalog rows are never deleted anyway).
  ledgerAccountId        String?
  ledgerAccount          LedgerAccount? @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)
  ledgerAccountIsDefault Boolean?
  vatCodeId              String?
  vatCode                VatCode?       @relation(fields: [vatCodeId], references: [id], onDelete: Restrict)
  vatCodeIsDefault       Boolean?

  // ─── specs/20261119-accounting (T16): the copy columns ──────────────────────────────────
  // What this line BOOKS, copied by natural key from Accounting at the moment it
  // is booked (ADR 20261119-accounting-reference-data-belongs-to-accounting-api-...).
  // WellD CH lines only (CHECK refund_line_classification_ch_only). The FK
  // columns above stay until T24 drops them; nothing new reads them.
  //   account : both or neither (CHECK)
  //   VAT     : both or neither (CHECK), rate 0..10000
  //   fx      : all three or none (CHECK), non-CHF lines only, the expense
  //             month's rate, WRITE-ONCE (trigger): null -> set at approval or at
  //             the first export, never changed afterwards, whatever the status.
  // `vatCodeCopy` maps the column "vatCode": the Prisma field `vatCode` above is
  // still the relation to the old catalog (dropped by T24), and a field name
  // cannot be used twice.
  accountNumber      String?
  accountName        String?
  vatCodeCopy        String?   @map("vatCode")
  vatRateBasisPoints Int?
  fxRateMicros       Int? // CHF per 1 unit x 1e6, > 0 and < 1e9
  fxRateMonth        DateTime? @db.Date // first day of the month of `date`
  fxRateCopiedAt     DateTime?

  // ─── specs/20261118-refund-accounting-export: receipt number ──────────────────────────────
  // Set once at approval (or by the release script), never changed or
  // deleted (trigger refund_line_accounting_guard, AC-4.7). The five columns
  // are set together or not at all (CHECK refund_line_receipt_all_or_none).
  // `receiptOwnerUserId` is the denormalised request.ownerUserId, only so the
  // unique index below can express "per employee and year".
  receiptNumber      String? // "MC26/014"
  receiptOwnerUserId String?
  receiptYear        Int? // year of `date`
  receiptSeq         Int?
  numberedAt         DateTime?

  attachments Attachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([receiptOwnerUserId, receiptYear, receiptSeq]) // AC-4.3/4.10 backstop
  @@index([ledgerAccountId])
  @@index([vatCodeId])
  @@index([requestId])
  @@index([requestId, entity]) // backs the per-request "at least one line matches" entity-scope predicate (ADR 20260716-entity-scoped-abac-refund-api)
  @@index([appliedRateEntryId]) // FK lookup / provenance queries
  @@map("refund_line")
}

// MileageRate — a per-entity, effective-dated mileage rate entry
// (specs/20260720-mileage-rate, US-4/US-5). Append-only: the SAME
// `BEFORE UPDATE/DELETE`-raising trigger pattern as `refund_audit_entry`
// (ADR 20260716-immutable-financial-audit-trail-refund) is added by this model's migration — no update/delete route is
// ever written for it (AC-4.7/5.2). This table IS its own audit trail
// (AC-5.1/5.3, ADR 20260719-refund-batch-audit-trail-extension parallel) — actor/timestamp/entity/value/validFrom
// all already live on the row; a separate audit table would be redundant
// (RefundAuditEntry is FK'd `requestId NOT NULL` and cannot represent a
// non-request-scoped event like a rate change).
//
// Two entirely independent per-entity series (AC-2.3) — `entity` scopes
// resolution, never a single suite-wide rate. `currency` is set server-side
// from `entity` (welld_ch→CHF, welld_it→EUR) at write time, stored
// explicitly for snapshot/display provenance (never independently chosen).
// `ratePerKmMicros` is an integer count of 1e-6 major currency units per km
// (Decision 3) — never Decimal/float, mirrors 007's money-handling posture.
// `validFrom` may be past, present, or future relative to `createdAt`
// (AC-4.8) — effective-rate resolution is always computed on read
// (`resolveEffectiveRate`, rates/resolve.ts), never a scheduled/cron flip
// (ADR 20260714-invitation-lifecycle-derived-expiry-state, spec Non-goal).
model MileageRate {
  id              String   @id @default(cuid())
  entity          Entity
  currency        Currency
  ratePerKmMicros Int
  validFrom       DateTime @db.Date
  createdByUserId String
  createdByEmail  String
  createdAt       DateTime @default(now())

  lines RefundLine[]

  @@index([entity, validFrom]) // effective-rate resolution: latest validFrom <= D per entity
  @@index([entity, createdAt]) // chronological history/audit listing (AC-4.1/5.3)
  @@map("mileage_rate")
}

// RefundSetting — an append-only key/value refund-configuration store
// (specs/20260722-refund-settings, D1/D3, ADR 20260722-refund-settings-append-only-self-auditing-store). Introduces exactly one key
// today (`accounting-distribution-email`, replacing the
// REFUND_ACCOUNTING_DISTRIBUTION_EMAIL env var, ADR 20260722-batch-email-recipient-live-resolution-amends-0021) but the shape is
// deliberately generic — a future setting is a new `key`, never a schema
// migration (Domain language, spec.md).
//
// The CURRENT value of a key is DERIVED ON READ as the latest row for that
// key (ADR 20260714-invitation-lifecycle-derived-expiry-state/0024 lineage) — there is no separate "current value" column
// anywhere. Append-only: the SAME `BEFORE UPDATE/DELETE`-raising trigger
// pattern as `mileage_rate`/`refund_audit_entry` (ADR 20260716-immutable-financial-audit-trail-refund/0024) is added by
// this model's migration — no update/delete route is ever written for it
// (AC-5.2). This table IS its own audit trail (AC-5.1/5.3, D3) — actor/
// timestamp/value all already live on the row; `RefundAuditEntry` cannot
// represent a settings change (its `requestId` FK is NOT NULL and a settings
// change has no request).
//
// `value: null` means "cleared" / "not configured" (AC-1.4) — a distinct,
// intentional state from "no rows yet for this key" (also not-configured,
// but with no audit history at all). `createdByUserId`/`createdByEmail` are
// ALWAYS the verified JWT `sub`/email (never the request body), except for
// the one documented cutover-seed row, whose actor is the literal
// `"system:settings-cutover"` (D7, refund-api/scripts/seed-setting.ts).
model RefundSetting {
  id              String   @id @default(cuid())
  key             String
  value           String?
  createdByUserId String
  createdByEmail  String
  createdAt       DateTime @default(now())

  @@index([key, createdAt]) // latest-per-key (current value) + chronological history/audit
  @@map("refund_setting")
}

// ─── specs/20261118-refund-accounting-export ───────────────────────────────────────────────
//
// Every model below except ReceiptCounter is APPEND-ONLY, enforced by a
// raising BEFORE UPDATE/DELETE trigger in the same migration (the pattern of
// `mileage_rate` / `refund_setting`, ADR 20260716-immutable-financial-audit-trail-refund).
// The catalog entries, the defaults history, the rates and the export log are
// their own audit trail. Never add an update/delete route for them.

// A ledger account of the books. Immutable once inserted; the number is never
// reused per entity. Activation lives in AccountingCatalogStatus.
model LedgerAccount {
  id              String                    @id @default(cuid())
  entity          Entity // only welld_ch is accepted at the API in this spec
  number          String // ^[0-9]{3,6}(\.[0-9]{1,3})?$ (allows "2620.1")
  name            String // 1..120 chars, trimmed
  createdByUserId String
  createdByEmail  String
  createdAt       DateTime                  @default(now())
  statusChanges   AccountingCatalogStatus[]
  lines           RefundLine[]
  defaults        ExpenseTypeDefault[]

  @@unique([entity, number]) // AC-1.2 backstop (P2002 -> 409)
  @@map("ledger_account")
}

// A VAT code. Immutable once inserted: the rate can never change (AC-1.5),
// enforced by the trigger.
model VatCode {
  id              String                    @id @default(cuid())
  entity          Entity
  code            String // ^[A-Z0-9_-]{1,16}$, upper-cased on input
  label           String // 1..80 chars
  rateBasisPoints Int // hundredths of a percent: 8.1 % = 810; CHECK 0..10000
  createdByUserId String
  createdByEmail  String
  createdAt       DateTime                  @default(now())
  statusChanges   AccountingCatalogStatus[]
  lines           RefundLine[]
  defaults        ExpenseTypeDefault[]

  @@unique([entity, code]) // AC-1.4 backstop
  @@map("vat_code")
}

// Append-only activation history of an account or a VAT code. No row = active
// since creation; the current state is the latest row.
// CHECK: exactly one of ledgerAccountId / vatCodeId is set.
model AccountingCatalogStatus {
  id              String         @id @default(cuid())
  ledgerAccountId String?
  ledgerAccount   LedgerAccount? @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)
  vatCodeId       String?
  vatCode         VatCode?       @relation(fields: [vatCodeId], references: [id], onDelete: Restrict)
  active          Boolean
  createdByUserId String
  createdByEmail  String
  createdAt       DateTime       @default(now())

  @@index([ledgerAccountId, createdAt])
  @@index([vatCodeId, createdAt])
  @@map("accounting_catalog_status")
}

// Append-only default classification per (entity, expense type); the current
// value is the latest row (AC-2.1 history). null = "no default" for that half.
model ExpenseTypeDefault {
  id              String         @id @default(cuid())
  entity          Entity
  type            ExpenseType
  ledgerAccountId String?
  ledgerAccount   LedgerAccount? @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)
  vatCodeId       String?
  vatCode         VatCode?       @relation(fields: [vatCodeId], references: [id], onDelete: Restrict)
  createdByUserId String
  createdByEmail  String
  createdAt       DateTime       @default(now())

  @@index([entity, type, createdAt])
  @@map("expense_type_default")
}

// specs/20261119-accounting (T16): the default classification per (entity,
// expense type) holds COPIES by natural key of what Accounting listed when the
// default was saved, no foreign key into Accounting (ADR
// 20261119-accounting-reference-data-belongs-to-accounting-api-...). Append-only
// (accounting_history_immutable() trigger); the current value is the latest row.
// Replaces ExpenseTypeDefault, which T24 drops. CHECKs: entity = welld_ch,
// number and name both or neither (null = "no default"), VAT code, label and
// rate all or none.
model ExpenseTypeAccountingDefault {
  id                 String      @id @default(cuid())
  entity             Entity
  type               ExpenseType
  accountNumber      String?
  accountName        String?
  vatCode            String?
  vatLabel           String?
  vatRateBasisPoints Int?
  createdByUserId    String
  createdByEmail     String
  createdAt          DateTime    @default(now())

  @@index([entity, type, createdAt])
  @@map("expense_type_accounting_default")
}

// specs/20261119-accounting (T16): the designated VAT code of foreign-currency
// lines, as an append-only history of copies (replaces the refund_setting key
// `accounting.welld_ch.foreign-currency-vat-code`, whose immutable rows stay
// unread). The current value is the latest row; all-null = cleared.
model ForeignCurrencyVatDesignation {
  id                 String   @id @default(cuid())
  entity             Entity
  vatCode            String?
  vatLabel           String?
  vatRateBasisPoints Int?
  createdByUserId    String
  createdByEmail     String
  createdAt          DateTime @default(now())

  @@index([entity, createdAt])
  @@map("foreign_currency_vat_designation")
}

// Per (employee, year of the expense date) receipt counter, row-locked by the
// approval transaction. NOT append-only: `lastSeq` grows. The trigger makes
// `lastSeq` monotonic, freezes the key, `startAfter` and `startAfterSetBy`
// after insert, and refuses DELETE.
model ReceiptCounter {
  ownerUserId     String
  year            Int
  lastSeq         Int // highest number issued (= startAfter before the first)
  startAfter      Int      @default(0) // one-time offset; 0 = start at 001
  startAfterSetBy String? // "system:accounting-release" when an offset was loaded
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@id([ownerUserId, year])
  @@map("receipt_counter")
}

// Append-only monthly exchange rates. Effective = latest `corrected` row, else
// the `fetched` row. CHECKs: currency <> CHF, rate > 0, month = first day.
// Partial unique index exchange_rate_fetched_once (raw SQL, in the migration)
// on (currency, month) WHERE origin = 'fetched': fetched once, never overwritten.
model ExchangeRateEntry {
  id              String             @id @default(cuid())
  currency        Currency // EUR | USD | GBP (CHF refused by CHECK)
  month           DateTime           @db.Date
  rateMicros      Int // CHF per 1 unit x 1e6 (0.9246 -> 924600)
  origin          ExchangeRateOrigin
  sourceUrl       String? // fetched: the exact URL read
  sourceMonth     String? // fetched: the <monat> echo, e.g. "2026-03"
  fetchedAt       DateTime? // fetched
  createdByUserId String // "system:fx-fetch" | admin sub
  createdByEmail  String
  createdAt       DateTime           @default(now())

  @@index([currency, month, createdAt])
  @@map("exchange_rate_entry")
}

// Append-only log of every fetch attempt (AC-5.6 "last fetch failed, and when").
model ExchangeRateFetchAttempt {
  id            String   @id @default(cuid())
  month         DateTime @db.Date
  trigger       String // admin | settings_view | export
  outcome       String // ok | failed | not_fetchable | disabled
  errorCode     String? // timeout | http_<status> | parse | month_mismatch | currency_missing
  recorded      Json? // { EUR: 924600, ... } newly recorded
  discrepancies Json? // { EUR: { inEffect, sourceNow } } source differs from the fetched row
  actorUserId   String
  createdAt     DateTime @default(now())

  @@index([month, createdAt])
  @@index([createdAt])
  @@map("exchange_rate_fetch_attempt")
}

// Append-only accounting-export log (AC-6.10): one row per CSV download.
model RefundBatchExport {
  id                String      @id @default(cuid())
  batchId           String
  batch             RefundBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  actorUserId       String
  actorEmail        String
  rowCount          Int
  excludedLineCount Int // WellD Italia lines left out
  contentSha256     String
  formatVersion     Int
  createdAt         DateTime    @default(now())

  @@index([batchId, createdAt])
  @@map("refund_batch_export")
}

// Attachment — a receipt file attached to a specific expense line (T5;
// object-storage wiring lands in T9, ADR 20260716-eu-object-storage-refund-attachments).
//
// objectKey is globally unique (refund/{requestId}/{lineId}/{attachmentId}/
// {safeName}) — the presigned-upload/download key, never guessable, no user
// PII in the key itself. uploadStatus starts `pending` (two-phase presigned
// upload — mint, then confirm via HEAD); only `stored` attachments are ever
// returned by refund-api's own read routes (T9's reconcile-on-read posture,
// no cron, ADR 20260714-invitation-lifecycle-derived-expiry-state precedent).
model Attachment {
  id     String     @id @default(cuid())
  lineId String
  line   RefundLine @relation(fields: [lineId], references: [id], onDelete: Cascade)

  objectKey    String       @unique
  fileName     String
  contentType  String
  sizeBytes    Int
  uploadStatus UploadStatus @default(pending)

  createdAt DateTime @default(now())

  @@index([lineId])
  @@map("attachment")
}

// RefundAuditEntry — append-only financial audit trail (US-8, ADR 20260716-immutable-financial-audit-trail-refund).
//
// IMMUTABILITY IS ENFORCED AT THE DATABASE LEVEL, not merely by the absence
// of an update/delete route: this migration's raw SQL adds a `BEFORE
// UPDATE/DELETE` trigger on this table that RAISEs an exception on any write
// attempt (ADR 20260716-immutable-financial-audit-trail-refund decision 2 — a raising trigger was chosen over a silent
// `CREATE RULE ... DO INSTEAD NOTHING`, so an inadvertent write attempt fails
// loudly). Never add an update/delete route for this model.
//
// `request` uses `onDelete: Restrict` (NOT Prisma's default `Cascade`):
// combined with the route guard that only ever permits `DELETE /requests/:id`
// while `status == draft` (409 otherwise), any request that ever transitioned
// past `draft` — and therefore has at least one audit row — becomes
// physically undeletable at the database level (AC-8.3), independent of and
// in addition to the application-level status guard.
model RefundAuditEntry {
  id        String        @id @default(cuid())
  requestId String
  request   RefundRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  lineId    String?
  // Set on batch_compiled|batch_paid|batch_discarded rows only; null on every
  // pre-existing 007 action, which has no batch to reference
  // (specs/20260719-refund-monthly-processing, ADR 20260719-refund-batch-audit-trail-extension). onDelete: Restrict
  // matches the requestId FK above — a RefundBatch with audit history is as
  // physically undeletable as a request with audit history.
  batchId   String?
  batch     RefundBatch?  @relation(fields: [batchId], references: [id], onDelete: Restrict)

  actorUserId String
  actorEmail  String
  action      AuditAction
  // e.g. { rejectionMotivation } | { lineId, fromCents, toCents } — see
  // plan.md's per-action detail shape.
  detail      Json?

  createdAt DateTime @default(now())

  @@index([requestId, createdAt])
  @@index([batchId]) // AC-7.1 "the full set of request IDs affected" per (batchId, action)
  @@map("refund_audit_entry")
}
