generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────────────────
//
// Native Prisma enums (departing from estimai-api/notify-api's "String +
// zod-boundary validation" convention — see plan.md § Data model) because
// this domain's closed sets are genuinely fixed by the spec/plan (the twelve
// expense types, the four-state lifecycle, the two wellD legal entities, the
// five audit actions, the two-phase upload status) and Postgres-level enum
// constraints add a second, DB-native line of defense for financial data —
// consistent with this plan's overall "defense in depth" posture (ADR-0018).

// draft|submitted|approved|rejected|paid. `withdrawn` is NOT a status — it is
// an AuditAction recording the submitted→draft transition (Gate-2 D1,
// plan.md Risk R6).
//
// `paid` (specs/008-refund-monthly-processing, ADR-0020) is a fifth, terminal
// value — it SUPERSEDES the original 007 "do not add a fifth value here"
// freeze (that freeze was never given its own ADR; ADR-0020 is the canonical
// record of why it no longer holds). `paid` inherits every existing
// mutation guard for free: 007's edit/delete/decide guards gate on
// `status == 'draft'` or `status == 'submitted'` only — `paid` is neither,
// so it is exactly as immutable as `approved`/`rejected` with zero guard
// changes (verified against lines.repo/lifecycle.repo/decide.repo).
enum RefundStatus {
  draft
  submitted
  approved
  rejected
  paid
}

// Compiled-batch lifecycle (specs/008-refund-monthly-processing, ADR-0020).
// Exactly three values, each reached at most once per batch, both exits
// (paid, discarded) are terminal and mutually exclusive (compare-and-swap
// on `status='compiled'` — see RefundBatch below).
enum BatchStatus {
  compiled
  paid
  discarded
}

// Reuses auth's `user.entity` string values verbatim (welld_it | welld_ch).
// Currency used to be DERIVED from this — as of the 2026-07-17 amendment
// (plan.md § Money handling) currency is an INDEPENDENTLY-STORED per-line
// field (see `Currency` below): any (entity, currency) combination is valid,
// so this enum no longer implies a currency.
enum Entity {
  welld_it
  welld_ch
}

// Independently-stored per-line currency (2026-07-17 amendment — reverses
// the original "derived from entity, never stored" decision, plan.md §
// Money handling). Records what was ACTUALLY paid in, which may differ from
// the entity's "home" currency (e.g. a welld_it line paid in CHF or USD).
// Never constrained by `entity` at the DB or API level.
enum Currency {
  EUR
  CHF
  USD
  GBP
}

// The twelve expense types from the spec's line-item table. `km` (RefundLine)
// is required and >0 iff type == travel_km, rejected for every other type
// (AC-1.2).
enum ExpenseType {
  travel_highway
  travel_km
  travel_parking
  travel_train
  travel_other_public_transport
  company_manuals
  stationery
  representation_meals
  representation_gifts
  office_material
  postal
  telephone
}

// One row per audited state-relevant event (US-8, ADR-0018). Written inside
// the same transaction as the event it records.
//
// batch_compiled|batch_paid|batch_discarded (specs/008-refund-monthly-processing,
// ADR-0020/0022) extend this in place — one row per affected request per
// batch action, `batchId` set on these three only (see RefundAuditEntry
// below). No new table, no new trigger: the existing ADR-0018 immutability
// trigger applies to these rows unchanged.
enum AuditAction {
  submitted
  withdrawn
  approved
  rejected
  approved_total_set
  batch_compiled
  batch_paid
  batch_discarded
}

// Two-phase presigned upload (ADR-0016, wired by T9): `pending` until the
// browser's direct-to-bucket upload is confirmed via HEAD, then `stored`.
// Only `stored` attachments are ever surfaced by refund-api's own routes.
enum UploadStatus {
  pending
  stored
}

// ─── Models ─────────────────────────────────────────────────────────────────

// RefundRequest — the top-level expense-reimbursement document (T5,
// specs/007-refund-service, plan.md § Data model).
//
// ownerUserId is the JWT `sub` (ADR-0005 pattern) — NEVER taken from the
// request body; every query is scoped to it (employee-owned) or to the
// entity-scope predicate (accounting review, ADR-0015). ownerEmail/ownerName
// are snapshots taken at creation time for accounting display (AC-6.1) — this
// service holds no `User` table (users live only in the `auth` DB), mirroring
// estimai-api/notify-api's sub-as-foreign-key-less-ownership convention.
//
// A request has NO single entity — its lines may straddle both welld_it and
// welld_ch (AC-3.5/6.6) — so entity scoping is evaluated per-request via "at
// least one line matches" (ADR-0015), never via a column on this table.
model RefundRequest {
  id                  String       @id @default(cuid())
  ownerUserId         String
  ownerEmail          String
  ownerName           String?
  status              RefundStatus @default(draft)
  submittedAt         DateTime?
  decidedAt           DateTime?
  decidedByUserId     String?
  decidedByEmail      String?
  // Non-null iff status == rejected (AC-7.3); left null/untouched otherwise.
  rejectionMotivation String?
  // LIVE batch claim pointer (specs/008-refund-monthly-processing, ADR-0020).
  // NULL = eligible for a future compile; non-null = currently claimed by a
  // `compiled` or `paid` RefundBatch. Nulled on discard (released back to
  // the candidate pool) and overwritable by a later batch once released —
  // this field is NOT the permanent membership record (see RefundBatchItem
  // for that). onDelete: Restrict — a claimed request cannot be deleted out
  // from under its batch.
  batchId             String?
  batch               RefundBatch? @relation(fields: [batchId], references: [id], onDelete: Restrict)

  lines        RefundLine[]
  auditEntries RefundAuditEntry[]
  batchItems   RefundBatchItem[]  @relation("BatchItemRequest")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerUserId, status]) // list-own (AC-3.1)
  @@index([status]) // queue base filter (AC-5.1), combined with the line entity join at query time
  @@index([status, batchId, decidedAt]) // candidate query: approved ∧ batchId NULL ∧ decidedAt<=cutoff (specs/008 AC-1.2)
  @@map("refund_request")
}

// RefundBatch — a compiled run: a frozen set of `approved` requests as of a
// chosen cutoff, tied to one generated PDF (specs/008-refund-monthly-processing,
// ADR-0019/0020). Never mutated in place beyond its own terminal-once status
// transition and the email/paid/discarded provenance fields below.
model RefundBatch {
  id                     String      @id @default(cuid())
  cutoff                 DateTime // AC-1.1 (defaults to now if not overridden — applied in the handler, not a DB default)
  status                 BatchStatus @default(compiled)
  createdByUserId        String // generating accounting user (AC-1.6 header)
  createdByEmail         String
  // refund/batches/{id}/compiled.pdf — no PII in the key (ADR-0019).
  pdfObjectKey           String      @unique
  // The configured distribution address, captured at compile time (ADR-0021).
  recipientEmailSnapshot String
  // Compilation-email delivery status surfaced in-app (AC-3.2), updated on
  // send/resend. "sent" | "failed" | null (never attempted) — validated at
  // the application boundary, not a DB enum (mirrors notify-api's own
  // delivery-status convention).
  emailStatus            String?
  emailLastAttemptAt     DateTime?
  emailDeliveryId        String? // notify-api EmailDelivery id, for support tracing
  // Terminal-transition provenance (the audit trail is the authoritative
  // record of *that* it happened — these back the AC-2.1/AC-6.1 in-app
  // display without a join).
  paidAt                 DateTime?
  paidByEmail            String?
  discardedAt            DateTime?
  discardedByEmail       String?

  items        RefundBatchItem[]
  requests     RefundRequest[] // live "currently claimed by" pointer (nulled on discard)
  auditEntries RefundAuditEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt]) // history list (AC-8.1/8.2)
  @@map("refund_batch")
}

// RefundBatchItem — immutable membership snapshot (specs/008-refund-monthly-processing,
// ADR-0020). Records that a request was ONCE in a batch, kept forever even
// after discard and even if the request is later re-included in a different
// batch (AC-6.3, AC-7.3). This — NOT RefundRequest.batchId — is the durable
// membership of record and the input ADR-0019's PDF renderer reads from, so
// a discarded batch's PDF still resolves (AC-1.10/6.3). onDelete: Restrict
// on both FKs — never deleted, and makes a once-batched request/batch
// physically undeletable.
model RefundBatchItem {
  id        String        @id @default(cuid())
  batchId   String
  batch     RefundBatch   @relation(fields: [batchId], references: [id], onDelete: Restrict)
  requestId String
  request   RefundRequest @relation("BatchItemRequest", fields: [requestId], references: [id], onDelete: Restrict)
  createdAt DateTime      @default(now())

  @@unique([batchId, requestId]) // a request appears once per batch
  @@index([requestId]) // AC-7.3 "which batches has this request ever been in"
  @@map("refund_batch_item")
}

// RefundLine — a single expense-line item, entity-scoped individually
// (T5, plan.md § Data model).
//
// requestedAmountCents is employee-entered (AC-1.2); approvedTotalCents is
// set during accounting review (AC-7.1/7.2), defaulting to
// requestedAmountCents on approve for any line left untouched (application
// logic, T12 — not a DB default, since "untouched" must be distinguishable
// from "explicitly set to the same value" during review).
//
// Money is stored as integer minor units (cents/centesimi), never Decimal or
// float — exact, unambiguous, trivially summable for per-currency subtotals
// (plan.md § Money handling). Currency is an INDEPENDENTLY-STORED field
// (2026-07-17 amendment — reverses the original "derived from entity, never
// stored" decision) — it records what was actually paid in, decoupled from
// `entity`; any (entity, currency) combination is valid, and subtotals now
// group purely by the stored `currency`, never by entity.
//
// specs/009-mileage-rate amendment: for `type == travel_km` lines ONLY,
// `currency` is forced server-side from `entity` (welld_ch→CHF, welld_it→EUR)
// rather than independently chosen — see appliedRate* below and
// requests/lines.repo.ts. Every other type's currency field is unaffected.
model RefundLine {
  id        String        @id @default(cuid())
  requestId String
  request   RefundRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  date                 DateTime    @db.Date
  type                 ExpenseType
  motivo               String
  entity               Entity
  currency             Currency
  requestedAmountCents Int
  // Required and > 0 iff type == travel_km; rejected (422) if present for any
  // other type (AC-1.2/1.6). Nullable at the DB level — validated at the API
  // boundary, not by a CHECK constraint, so the same table shape serves every
  // expense type without a partial/conditional column.
  km                   Int?
  approvedTotalCents   Int?

  // ─── specs/009-mileage-rate: applied-rate snapshot (Decision 1) ──────────
  // All three are non-null ONLY once this line's containing request has ever
  // reached `submitted` AND it is currently frozen — written together inside
  // the submit transaction (lifecycle.repo.ts), cleared together back to null
  // on withdraw-to-draft (AC-3.1/3.2). Null for: a draft/never-submitted
  // travel_km line (live/derived-on-read, ADR-0013), any non-travel_km line,
  // and a legacy pre-feature submitted travel_km line (AC-1.7, this
  // migration never backfills). onDelete: Restrict — a MileageRate a line
  // references can never be deleted (and MileageRate rows are never deleted
  // anyway — append-only, AC-4.7).
  appliedRateMicros    Int?
  appliedRateValidFrom DateTime?    @db.Date
  appliedRateEntryId   String?
  appliedRate          MileageRate? @relation(fields: [appliedRateEntryId], references: [id], onDelete: Restrict)

  attachments Attachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requestId])
  @@index([requestId, entity]) // backs the per-request "at least one line matches" entity-scope predicate (ADR-0015)
  @@index([appliedRateEntryId]) // FK lookup / provenance queries
  @@map("refund_line")
}

// MileageRate — a per-entity, effective-dated mileage rate entry
// (specs/009-mileage-rate, US-4/US-5). Append-only: the SAME
// `BEFORE UPDATE/DELETE`-raising trigger pattern as `refund_audit_entry`
// (ADR-0018) is added by this model's migration — no update/delete route is
// ever written for it (AC-4.7/5.2). This table IS its own audit trail
// (AC-5.1/5.3, ADR-0022 parallel) — actor/timestamp/entity/value/validFrom
// all already live on the row; a separate audit table would be redundant
// (RefundAuditEntry is FK'd `requestId NOT NULL` and cannot represent a
// non-request-scoped event like a rate change).
//
// Two entirely independent per-entity series (AC-2.3) — `entity` scopes
// resolution, never a single suite-wide rate. `currency` is set server-side
// from `entity` (welld_ch→CHF, welld_it→EUR) at write time, stored
// explicitly for snapshot/display provenance (never independently chosen).
// `ratePerKmMicros` is an integer count of 1e-6 major currency units per km
// (Decision 3) — never Decimal/float, mirrors 007's money-handling posture.
// `validFrom` may be past, present, or future relative to `createdAt`
// (AC-4.8) — effective-rate resolution is always computed on read
// (`resolveEffectiveRate`, rates/resolve.ts), never a scheduled/cron flip
// (ADR-0013, spec Non-goal).
model MileageRate {
  id              String   @id @default(cuid())
  entity          Entity
  currency        Currency
  ratePerKmMicros Int
  validFrom       DateTime @db.Date
  createdByUserId String
  createdByEmail  String
  createdAt       DateTime @default(now())

  lines RefundLine[]

  @@index([entity, validFrom]) // effective-rate resolution: latest validFrom <= D per entity
  @@index([entity, createdAt]) // chronological history/audit listing (AC-4.1/5.3)
  @@map("mileage_rate")
}

// Attachment — a receipt file attached to a specific expense line (T5;
// object-storage wiring lands in T9, ADR-0016).
//
// objectKey is globally unique (refund/{requestId}/{lineId}/{attachmentId}/
// {safeName}) — the presigned-upload/download key, never guessable, no user
// PII in the key itself. uploadStatus starts `pending` (two-phase presigned
// upload — mint, then confirm via HEAD); only `stored` attachments are ever
// returned by refund-api's own read routes (T9's reconcile-on-read posture,
// no cron, ADR-0013 precedent).
model Attachment {
  id     String     @id @default(cuid())
  lineId String
  line   RefundLine @relation(fields: [lineId], references: [id], onDelete: Cascade)

  objectKey    String       @unique
  fileName     String
  contentType  String
  sizeBytes    Int
  uploadStatus UploadStatus @default(pending)

  createdAt DateTime @default(now())

  @@index([lineId])
  @@map("attachment")
}

// RefundAuditEntry — append-only financial audit trail (US-8, ADR-0018).
//
// IMMUTABILITY IS ENFORCED AT THE DATABASE LEVEL, not merely by the absence
// of an update/delete route: this migration's raw SQL adds a `BEFORE
// UPDATE/DELETE` trigger on this table that RAISEs an exception on any write
// attempt (ADR-0018 decision 2 — a raising trigger was chosen over a silent
// `CREATE RULE ... DO INSTEAD NOTHING`, so an inadvertent write attempt fails
// loudly). Never add an update/delete route for this model.
//
// `request` uses `onDelete: Restrict` (NOT Prisma's default `Cascade`):
// combined with the route guard that only ever permits `DELETE /requests/:id`
// while `status == draft` (409 otherwise), any request that ever transitioned
// past `draft` — and therefore has at least one audit row — becomes
// physically undeletable at the database level (AC-8.3), independent of and
// in addition to the application-level status guard.
model RefundAuditEntry {
  id        String        @id @default(cuid())
  requestId String
  request   RefundRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  lineId    String?
  // Set on batch_compiled|batch_paid|batch_discarded rows only; null on every
  // pre-existing 007 action, which has no batch to reference
  // (specs/008-refund-monthly-processing, ADR-0022). onDelete: Restrict
  // matches the requestId FK above — a RefundBatch with audit history is as
  // physically undeletable as a request with audit history.
  batchId   String?
  batch     RefundBatch?  @relation(fields: [batchId], references: [id], onDelete: Restrict)

  actorUserId String
  actorEmail  String
  action      AuditAction
  // e.g. { rejectionMotivation } | { lineId, fromCents, toCents } — see
  // plan.md's per-action detail shape.
  detail      Json?

  createdAt DateTime @default(now())

  @@index([requestId, createdAt])
  @@index([batchId]) // AC-7.1 "the full set of request IDs affected" per (batchId, action)
  @@map("refund_audit_entry")
}
