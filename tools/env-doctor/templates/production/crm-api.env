# env-doctor template — crm-api (production). See infra/README.md § Variable reference.
# (value taxonomy documented in ./auth.env)
# specs/017-crm, 018 (estimates, offers, attachments), 019 (notifications), 020 (offer
# documents). crm-api is a JWKS + authorization-enforcing resource server (ADR-0014 lineage,
# ADR-0052). Its secrets: the database password (DATABASE_URL), the bucket credentials (set
# by reference to the Railway bucket by infra/provision-tool.sh) and its service-client
# secret (a Railway Shared Variable).

DATABASE_URL=postgresql://${{Postgres.PGUSER}}:${{Postgres.PGPASSWORD}}@${{Postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/crm

# Shell origin only. crm-ui is a federated remote, so the browser Origin on every call is
# the shell's (ADR-0006).
ALLOWED_ORIGINS=https://operai.welld.io

AUTH_ISSUER=https://auth.operai.welld.io
AUTH_JWKS_URL=http://${{auth.RAILWAY_PRIVATE_DOMAIN}}:${{auth.PORT}}/auth/jwks
# Internal CALLS on auth: GET /authz/resolve (ADR-0014) and POST /authz/users/identities
# (ADR-0039). Private DNS, distinct from AUTH_ISSUER.
AUTH_BASE_URL=http://${{auth.RAILWAY_PRIVATE_DOMAIN}}:${{auth.PORT}}
AUTH_AUDIENCE=${{shared.AUTH_AUDIENCE}}

# specs/018: estimates are created in EstimAI with the caller's own JWT, over private networking.
ESTIMAI_API_URL=http://${{estimai-api.RAILWAY_PRIVATE_DOMAIN}}:${{estimai-api.PORT}}

# specs/018: offers, attachments and letterheads in the CRM's own EU bucket (ADR-0016 lineage).
# CRM_S3_BUCKET / _ENDPOINT / _ACCESS_KEY_ID / _SECRET_ACCESS_KEY are set by reference to the
# Railway bucket `crm` by infra/provision-tool.sh --bucket.
CRM_S3_REGION=ams
CRM_S3_EU_ENDPOINT_HOSTS=t3.storageapi.dev

# specs/019: CRM notifications through notify-api (ADR-0049/0056). The id is a key of auth's
# SERVICE_CLIENTS (scope "notifications.push emails.send projects.purchase-orders.read" since specs/022);
# the secret equals that entry's. One service client for both calls: env.ts requires the pair with
# NOTIFY_INTERNAL_URL or PROJECTS_INTERNAL_URL, and never alone.
NOTIFY_INTERNAL_URL=${{shared.NOTIFY_INTERNAL_URL}}
SERVICE_CLIENT_ID=crm-api
SERVICE_CLIENT_SECRET=${{shared.CRM_SERVICE_CLIENT_SECRET}}

# specs/018 AC-3.3 (ADR-0073): the audience of the service JWT estimai-api's estimate notices
# carry. Byte-identical to auth's, different from AUTH_AUDIENCE; without it every notice is a 401.
# specs/022: the deal page reads its project and Bexio order id from projects-api's
# `GET /system/purchase-orders` as itself (scope projects.purchase-orders.read, ADR-0060), same service client.
# Required here — without it the deal page says the delivery side is unavailable.
PROJECTS_INTERNAL_URL=http://${{projects-api.RAILWAY_PRIVATE_DOMAIN}}:${{projects-api.PORT}}

# specs/021: projects-api reads CRM companies from `GET /system/companies` with a scoped service
# JWT (scope crm.companies.read, ADR-0059). SERVICE_AUDIENCE is the `aud` auth stamps on it: byte-
# identical to auth's and notify-api's, and DIFFERENT from AUTH_AUDIENCE (ADR-0044). Required in
# production — without it every /system/* request is a 401.
SERVICE_AUDIENCE=${{shared.SERVICE_AUDIENCE}}

PORT=8084
NODE_ENV=production
