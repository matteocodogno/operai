# env-doctor template — refund-api (production). See infra/README.md § Variable reference.
# (value taxonomy documented in ./auth.env)

DATABASE_URL=postgresql://${{Postgres.PGUSER}}:${{Postgres.PGPASSWORD}}@${{Postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/refund

# shell origin + admin-ui's OWN origin (the /rates + /settings direct calls, ADR-0023).
ALLOWED_ORIGINS=https://operai.welld.io,https://admin.operai.welld.io

AUTH_ISSUER=https://auth.operai.welld.io
AUTH_JWKS_URL=http://${{auth.RAILWAY_PRIVATE_DOMAIN}}:${{auth.PORT}}/auth/jwks
# Internal CALL: the GET /authz/resolve base (ADR-0014). A call, so private DNS —
# distinct from AUTH_ISSUER. (This is the var that was localhost in prod → 503.)
AUTH_BASE_URL=http://${{auth.RAILWAY_PRIVATE_DOMAIN}}:${{auth.PORT}}
AUTH_AUDIENCE=${{shared.AUTH_AUDIENCE}}

NOTIFY_INTERNAL_URL=http://${{notify-api.RAILWAY_PRIVATE_DOMAIN}}:${{notify-api.PORT}}
NOTIFY_INTERNAL_TOKEN=${{shared.NOTIFY_INTERNAL_TOKEN}}

# Public deep-link base for the compiled-batch email — the shell's origin (ADR-0021).
REFUND_APP_BASE_URL=https://operai.welld.io

# REFUND_S3_* — object storage for receipt attachments (ADR-0016). PROVISIONED: a
# Railway S3-compatible bucket on the custom, non-AWS endpoint t3.storageapi.dev,
# which is why REFUND_S3_EU_ENDPOINT_HOSTS exists (src/lib/s3Residency.ts is
# endpoint-aware — an AWS-region allowlist would wrongly reject this bucket).
#
# The two credential vars are secrets with NO 1Password item yet, so they are set
# directly on the Railway service and deliberately left out of this template
# rather than committed as a fake ${OP:…} path that `--resolve` would fail on.
# The three non-secret vars are listed so the contract stops silently omitting
# them; keep them in sync with the dashboard.
#
# REMINDER: the bucket ALSO needs a CORS rule for https://operai.welld.io (POST) or
# every receipt upload fails in the browser — see infra/README.md § "Receipt bucket
# CORS". That is bucket state, not an env var, so nothing here can verify it.
REFUND_S3_ENDPOINT=https://t3.storageapi.dev
REFUND_S3_REGION=ams
REFUND_S3_BUCKET=refund-receipt-g0jy7xar4e
REFUND_S3_EU_ENDPOINT_HOSTS=t3.storageapi.dev
# REFUND_ACCOUNTING_DISTRIBUTION_EMAIL — REMOVED (specs/011). Now an admin-managed
# refund_setting row, never an env var. Do NOT add it back.

PORT=8080
NODE_ENV=production
