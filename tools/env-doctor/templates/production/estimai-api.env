# env-doctor template — estimai-api (production). See infra/README.md § Variable reference.
# (value taxonomy documented in ./auth.env)

DATABASE_URL=postgresql://${{Postgres.PGUSER}}:${{Postgres.PGPASSWORD}}@${{Postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/estimai
ALLOWED_ORIGINS=https://operai.welld.io

# Public identity claim — must equal auth's BETTER_AUTH_URL (checked).
AUTH_ISSUER=https://auth.operai.welld.io
# Internal CALL to auth's JWKS over private networking.
AUTH_JWKS_URL=http://${{auth.RAILWAY_PRIVATE_DOMAIN}}:${{auth.PORT}}/auth/jwks
# Suite-wide shared variable.
AUTH_AUDIENCE=${{shared.AUTH_AUDIENCE}}

# Service-token credentials (specs/016, ADR-0049). The id must be a key of auth's SERVICE_CLIENTS
# (scope "notifications.push estimate-notices.send") and the secret must equal that entry's secret.
# The secret is a Railway Shared Variable; never commit a value.
SERVICE_CLIENT_ID=estimai-api
SERVICE_CLIENT_SECRET=${{shared.ESTIMAI_SERVICE_CLIENT_SECRET}}

# specs/018 AC-3.3 (ADR-0073): where a closed or reopened estimate is announced to the CRM,
# over private networking. Unset, the CRM never learns that an estimate is ready.
CRM_INTERNAL_URL=http://${{crm-api.RAILWAY_PRIVATE_DOMAIN}}:${{crm-api.PORT}}

# specs/022: projects-api reads an estimate's man-days from `GET /system/estimates/{id}/summary`
# with a scoped service JWT (scope estimai.estimates.read, ADR-0061). SERVICE_AUDIENCE is the `aud`
# auth stamps on it: byte-identical to auth's, notify-api's, crm-api's and projects-api's, and
# DIFFERENT from AUTH_AUDIENCE (ADR-0044). Required in production — without it every /system/*
# request is a 401.
SERVICE_AUDIENCE=${{shared.SERVICE_AUDIENCE}}

PORT=8080
NODE_ENV=production
