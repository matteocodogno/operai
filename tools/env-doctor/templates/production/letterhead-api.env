# env-doctor template — letterhead-api (production). See infra/README.md § Variable reference.
# (value taxonomy documented in ./auth.env)
# specs/20261116-letterhead-service. letterhead-api (Rust, Typst embedded; ADR 20261116-letterhead-api-is-a-rust-service-with-typst-embedded-for-document-layout-only) lays out whole
# documents for every tool. It is a JWKS resource server with TWO audiences: person tokens on its
# configurator routes (AUTH_AUDIENCE) and scoped service JWTs on /v1/render/* (SERVICE_AUDIENCE, scope
# "letterhead:render"). It keeps no document content after a render. Since specs/20261117-legal-entities it also has a
# service client of its own (below) to read the issuer's legal details from auth's registry.
# The process exits at startup if any of this is invalid (letterhead-api/api/src/env.rs).

DATABASE_URL=postgresql://${{Postgres.PGUSER}}:${{Postgres.PGPASSWORD}}@${{Postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/letterhead

# Shell origin only: letterheads-ui is a remote mounted by the shell (ADR 20260709-suite-frontend-module-federation).
ALLOWED_ORIGINS=https://operai.welld.io

AUTH_ISSUER=https://auth.operai.welld.io
AUTH_JWKS_URL=http://${{auth.RAILWAY_PRIVATE_DOMAIN}}:${{auth.PORT}}/auth/jwks
# Private DNS, distinct from AUTH_ISSUER (/authz/resolve for the configurator routes).
AUTH_BASE_URL=http://${{auth.RAILWAY_PRIVATE_DOMAIN}}:${{auth.PORT}}
AUTH_AUDIENCE=${{shared.AUTH_AUDIENCE}}

# Audience of the scoped service JWTs /v1/render/* verifies: byte-identical to auth's, notify-api's and
# crm-api's, and DIFFERENT from AUTH_AUDIENCE (the service refuses to start when they are equal).
# A new caller is a service client at auth with scope "letterhead:render", not a line here (AC-9.3).
SERVICE_AUDIENCE=${{shared.SERVICE_AUDIENCE}}

# specs/20261117-legal-entities (T12, AC-3.2, plan decision 3 and E14): letterhead-api asks auth for a service token as ITSELF
# (POST /system/service-token, over AUTH_BASE_URL) and reads GET /system/legal-entities with it. The id is a key of auth's
# SERVICE_CLIENTS, whose entry holds exactly the scope "legal-entities:read"; the secret is a Railway Shared Variable
# (LETTERHEAD_SERVICE_CLIENT_SECRET, >= 32 chars) byte-identical to that entry's `secret`. Set both in release step 2, after the
# new auth is live (infra/README.md § Legal entities rollout); code that does not read them yet ignores them. Without them, once
# the registry client ships, every render answers 503 legal_entities_unavailable (fail closed, no issuer-less document).
SERVICE_CLIENT_ID=letterhead-api
SERVICE_CLIENT_SECRET=${{shared.LETTERHEAD_SERVICE_CLIENT_SECRET}}

# Its OWN EU bucket for logos and backgrounds, never another tool's (AC-3.8). ASSUMED to be a Railway
# S3-compatible bucket on the same EU endpoint as the other tools' — NOT YET PROVISIONED: confirm endpoint
# and region once the bucket exists. LETTERHEAD_S3_BUCKET and the two credential vars
# (LETTERHEAD_S3_ACCESS_KEY_ID, LETTERHEAD_S3_SECRET_ACCESS_KEY) are set by reference to the Railway
# bucket `letterhead` and deliberately left out of this committed template.
LETTERHEAD_S3_ENDPOINT=https://t3.storageapi.dev
LETTERHEAD_S3_REGION=ams
LETTERHEAD_S3_EU_ENDPOINT_HOSTS=t3.storageapi.dev

# Render pool: workers x worker memory cap + the supervisor must fit the container (plan F4). Defaults 2 / 4.
LH_WORKERS=2
LH_QUEUE=4

PORT=8088
