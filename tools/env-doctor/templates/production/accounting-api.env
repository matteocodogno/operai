# env-doctor template — accounting-api (production). See infra/README.md § Variable reference.
# (value taxonomy documented in ./auth.env)
# specs/20261119-accounting (ADR 20261119-accounting-reference-data-belongs-to-accounting-api-which-consumers-read-live-with-no-copy-kept-across-requests-copy-by-natural-key-onto-what-they-book-and-refuse-to-act-when-they-cannot-read-it): the ledger accounts, VAT codes and monthly exchange rates of each
# legal entity. A JWKS + authorization-enforcing resource server (person tokens on /v1/*) with one narrow service read for refund-api
# (/system/v1/*, scope "accounting.reference.read", sub "system:refund-api"). Authoritative list: accounting-api/src/lib/env.ts,
# validated at startup (exits 1 naming the variable, never its value).
# It holds NO service client of its own and no *_INTERNAL_URL: it calls no service but auth's /authz/resolve and, on demand, the one
# fixed federal rates host (a constant in accounting-api/src/rates/bazgSource.ts, not a variable). Needs outbound HTTPS to it while
# ACCOUNTING_FX_SOURCE=bazg.
# infra/provision-tool.sh sets every uncommented KEY=VALUE of this file on the Railway service, by reference; no secret is in it.

# Its OWN logical database on the shared Postgres. The preDeploy (`bun run db:deploy`) migrates it, so it must exist before the first deploy.
DATABASE_URL=postgresql://${{Postgres.PGUSER}}:${{Postgres.PGPASSWORD}}@${{Postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/accounting

# Shell origin only: accounting-ui is a remote mounted by the shell (ADR 20260709-suite-frontend-module-federation). No wildcard (the service refuses it).
ALLOWED_ORIGINS=https://operai.welld.io

AUTH_ISSUER=https://auth.operai.welld.io
AUTH_JWKS_URL=http://${{auth.RAILWAY_PRIVATE_DOMAIN}}:${{auth.PORT}}/auth/jwks
# Internal CALL: the GET /authz/resolve base. A call, so private DNS — distinct from AUTH_ISSUER.
AUTH_BASE_URL=http://${{auth.RAILWAY_PRIVATE_DOMAIN}}:${{auth.PORT}}
AUTH_AUDIENCE=${{shared.AUTH_AUDIENCE}}

# Audience of the scoped service JWTs /system/v1/* verifies: byte-identical to auth's, notify-api's and crm-api's, and DIFFERENT from
# AUTH_AUDIENCE (the service refuses to start when they are equal). A second reader of /system/v1/* is a new scope at auth AND a change
# in accounting-api's code, never a line here.
SERVICE_AUDIENCE=${{shared.SERVICE_AUDIENCE}}

# Where the monthly average rates come from: `bazg` (default) calls the federal source on demand, `off` makes no outbound call and rates
# are typed by hand (offline and e2e). Any other value stops the service at startup. Moved here from refund-api's REFUND_FX_SOURCE.
ACCOUNTING_FX_SOURCE=bazg

PORT=8089
NODE_ENV=production
