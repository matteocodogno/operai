# env-doctor template — meetings-api (production). See infra/README.md § Meetings.
# (value taxonomy documented in ./auth.env)
# specs/021-meetings. meetings-api is a JWKS + authorization-enforcing resource server
# (ADR-0014 lineage, ADR-0058), a notify-api caller and a crm-api host-notice caller (ADR-0059),
# and a reader of audio bytes (ADR-0064). It stores AUDIO ONLY in its own EU bucket; transcripts
# and summaries live in Postgres. Every hop that touches content is EU-only and verified at
# STARTUP (ADR-0061, ADR-0069): the service exits 1 on a non-EU location, an audio bucket without the
# 29-day lifecycle rule or with versioning Enabled (ADR-0063), a transient Google bucket whose rules do
# not hold, Vertex data caching or request-response logging that is on or unreadable, or
# MEETINGS_AI_PROVIDER=fake.
#
# Single replica: the job runner (MEETINGS_WORKER, default on) lives inside this process
# (ADR-0062); numReplicas is pinned to 1 in meetings-api/railway.json.

DATABASE_URL=postgresql://${{Postgres.PGUSER}}:${{Postgres.PGPASSWORD}}@${{Postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/meetings

# Shell origin only. meetings-ui is a federated remote, so the browser Origin on every call is
# the shell's (ADR-0006). The audio bucket has its OWN CORS rule (infra/meetings-bucket-policy.sh).
ALLOWED_ORIGINS=https://operai.welld.io

AUTH_ISSUER=https://auth.operai.welld.io
AUTH_JWKS_URL=http://${{auth.RAILWAY_PRIVATE_DOMAIN}}:${{auth.PORT}}/auth/jwks
# Internal CALLS on auth: GET /authz/resolve (ADR-0014), POST /authz/users/identities (ADR-0039),
# GET /authz/users/directory and POST /system/service-token (ADR-0044). Private DNS, distinct
# from AUTH_ISSUER.
AUTH_BASE_URL=http://${{auth.RAILWAY_PRIVATE_DOMAIN}}:${{auth.PORT}}
AUTH_AUDIENCE=${{shared.AUTH_AUDIENCE}}

# notify-api's private address — the shared variable, as for inventory-api / crm-api.
NOTIFY_INTERNAL_URL=${{shared.NOTIFY_INTERNAL_URL}}

# The CRM host contract (ADR-0059): POST /meeting-host/v1/resolve as the caller (forwarded JWT) and
# POST /system/meeting-host/v1/notices as this service. Private networking, crm-api's own port.
CRM_API_URL=http://${{crm-api.RAILWAY_PRIVATE_DOMAIN}}:${{crm-api.PORT}}

# Scoped service JWT (ADR-0044/0049). The id is a key of auth's SERVICE_CLIENTS with EXACTLY the
# scopes "notifications.push host-notices.send"; the secret equals that entry's. A Railway Shared
# Variable, never committed. crm-api verifies the notices token with SERVICE_AUDIENCE.
SERVICE_CLIENT_ID=meetings-api
SERVICE_CLIENT_SECRET=${{shared.MEETINGS_SERVICE_CLIENT_SECRET}}

# Audio storage — its OWN bucket and credentials (ADR-0016 lineage), private, presigned URLs only.
# ASSUMED to be a Railway S3-compatible bucket on the same EU endpoint as crm-api's — NOT YET
# PROVISIONED: confirm endpoint and region once the bucket exists. MEETINGS_S3_BUCKET and the two
# credential vars (MEETINGS_S3_ACCESS_KEY_ID, MEETINGS_S3_SECRET_ACCESS_KEY) are set by reference to
# the Railway bucket by infra/provision-tool.sh --bucket and deliberately left out of this template.
# The bucket also needs the 29-day lifecycle rule, versioning off and a CORS rule for
# https://operai.welld.io — apply and verify with infra/meetings-bucket-policy.sh BEFORE the first
# deploy, or the startup check refuses to start the service.
MEETINGS_S3_ENDPOINT=https://t3.storageapi.dev
MEETINGS_S3_REGION=ams
MEETINGS_S3_EU_ENDPOINT_HOSTS=t3.storageapi.dev

# AI processing — Google Cloud, ONE dedicated project and ONE service account (specs/021 plan
# § Amendment 2026-11-05, ADR-0069). Transcription is Cloud Speech-to-Text v2 (Chirp 3, batch) through a
# TRANSIENT EU bucket; summaries and Q&A are Claude on Vertex AI. The Speech and Vertex endpoints are
# DERIVED from the locations below, never configured. Startup refuses (exit 1, value-free message) on a
# location outside the allowlist (`global`, `us`, London are refused), a model id naming fable or mythos,
# a key whose project_id differs from MEETINGS_GCP_PROJECT_ID, an ambient ANTHROPIC_VERTEX_BASE_URL, or a
# transient bucket whose rules do not hold (infra/meetings-gcs-transient-policy.sh --check proves them).
# The retired Azure/Bedrock/AWS variables must NOT be set here: env-doctor flags them.
MEETINGS_SPEECH_LOCATION=eu
MEETINGS_VERTEX_LOCATION=eu
# PLACEHOLDER — replace with the pinned model id once the live prompt-injection eval is green on it
# (specs/021 T103/T104, ADR-0061/0067). A model change is a deploy that needs a green eval, not a
# variable edit. Never a Fable or Mythos model (Vertex "Advanced AI" logging).
MEETINGS_VERTEX_MODEL_ID=SET-ME-pinned-model-id
# PLACEHOLDERS — NOT YET PROVISIONED. The project id and the transient bucket's name, once the Google
# project and bucket exist (infra/README.md § meetings-api).
MEETINGS_GCP_PROJECT_ID=SET-ME-gcp-project-id
MEETINGS_GCS_TRANSIENT_BUCKET=SET-ME-transient-bucket-name
# SECRET: the runtime service account's JSON key, base64-encoded, from 1Password. Rotate every 90 days.
MEETINGS_GCP_SERVICE_ACCOUNT_KEY=${OP:AIScream/OperAI - Meetings GCP SA/key-base64}

# "real" is REQUIRED in production; "fake" is refused at startup when NODE_ENV=production.
MEETINGS_AI_PROVIDER=real
# The job runner runs in-process (ADR-0062); "off"/"only" are for a future split of the worker.
MEETINGS_WORKER=on
# MEETINGS_TEST_HOSTS is test-only and is refused in production: it must NOT be set here.

PORT=8085
NODE_ENV=production
