# env-doctor template — meetings-api (production). See infra/README.md § Meetings.
# (value taxonomy documented in ./auth.env)
# specs/20261104-meetings. meetings-api is a JWKS + authorization-enforcing resource server
# (ADR 20260716-refund-api-authorization-enforcing-resource-server lineage, ADR 20261104-meetings-tool-shape-visibility-by-participation), a notify-api caller and a crm-api host-notice caller (ADR 20261104-meeting-host-contract-resolve-and-notices),
# and a reader of audio bytes (ADR 20261104-meetings-api-reads-audio-bytes-third-reader). It stores AUDIO ONLY in its own EU bucket; transcripts
# and summaries live in Postgres. Every hop that touches content is EU-only and verified at
# STARTUP (ADR 20261104-meetings-ai-providers-eu-zero-retention, ADR 20261105-meetings-ai-providers-google-cloud-eu): the service exits 1 on a non-EU location, an audio bucket without the
# 29-day lifecycle rule or with versioning Enabled (ADR 20261104-audio-retention-bucket-lifecycle-verified-at-startup), a transient Google bucket whose rules do
# not hold, Vertex data caching or request-response logging that is on or unreadable, or
# MEETINGS_AI_PROVIDER=fake.
#
# Single replica: the job runner (MEETINGS_WORKER, default on) lives inside this process
# (ADR 20261104-durable-job-runner-work-queued-state-derived); one replica is pinned in .railway/railway.ts.

DATABASE_URL=postgresql://${{Postgres.PGUSER}}:${{Postgres.PGPASSWORD}}@${{Postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/meetings

# Shell origin only. meetings-ui is a federated remote, so the browser Origin on every call is
# the shell's (ADR 20260709-suite-frontend-module-federation). The audio bucket has its OWN CORS rule (infra/meetings-bucket-policy.sh).
ALLOWED_ORIGINS=https://operai.welld.io

AUTH_ISSUER=https://auth.operai.welld.io
AUTH_JWKS_URL=http://${{auth.RAILWAY_PRIVATE_DOMAIN}}:${{auth.PORT}}/auth/jwks
# Internal CALLS on auth: GET /authz/resolve (ADR 20260716-refund-api-authorization-enforcing-resource-server), POST /authz/users/identities (ADR 20260807-live-identity-resolution-by-id-fail-soft),
# GET /authz/users/directory and POST /system/service-token (ADR 20261006-scoped-service-jwt-fourth-notify-caller). Private DNS, distinct
# from AUTH_ISSUER.
AUTH_BASE_URL=http://${{auth.RAILWAY_PRIVATE_DOMAIN}}:${{auth.PORT}}
AUTH_AUDIENCE=${{shared.AUTH_AUDIENCE}}

# notify-api's private address — the shared variable, as for inventory-api / crm-api.
NOTIFY_INTERNAL_URL=${{shared.NOTIFY_INTERNAL_URL}}

# The CRM host contract (ADR 20261104-meeting-host-contract-resolve-and-notices): POST /meeting-host/v1/resolve as the caller (forwarded JWT) and
# POST /system/meeting-host/v1/notices as this service. Private networking, crm-api's own port.
CRM_API_URL=http://${{crm-api.RAILWAY_PRIVATE_DOMAIN}}:${{crm-api.PORT}}
PROJECTS_API_URL=http://${{projects-api.RAILWAY_PRIVATE_DOMAIN}}:${{projects-api.PORT}}

# Where a meeting's hours facts are posted (specs/20261112-meeting-hours, ADR 20261124-meeting-hours-facts-pushed-by-their-owner-as-a-versioned-state-built-at-send-time-through-an-until-delivered-outbox-and-applied-by-hours-api-only-when-not-older):
# POST /system/meeting-hours/v1/notices on hours-api, as this service (scope "meeting-hours-notices.send"). Private networking, hours-api's
# own port, never its public domain: the service token must not travel there. Required in production by src/lib/env.ts (default
# http://localhost:8090 elsewhere); without it no meeting ever gives anyone an automatic entry.
HOURS_API_URL=http://${{hours-api.RAILWAY_PRIVATE_DOMAIN}}:${{hours-api.PORT}}

# Scoped service JWT (ADR 20261006-scoped-service-jwt-fourth-notify-caller/0049). The id is a key of auth's SERVICE_CLIENTS with EXACTLY the
# scopes "notifications.push host-notices.send meeting-hours-notices.send"; the secret equals that entry's. A Railway Shared
# Variable, never committed. crm-api verifies the host-notices token with SERVICE_AUDIENCE; hours-api verifies the hours notices with
# the same audience and the sub allowlist `system:meetings-api`. Add `meeting-hours-notices.send` to the entry in auth ONLY after the auth
# that knows the scope is live (an unknown scope stops auth, ADR 20261108-crm-pushes-deal-links-to-estimai).
SERVICE_CLIENT_ID=meetings-api
SERVICE_CLIENT_SECRET=${{shared.MEETINGS_SERVICE_CLIENT_SECRET}}

# The audience of the scoped service JWTs meetings-api VERIFIES on GET /system/meetings/hosts
# (hours-api, scope "meetings.hosts.read", sub "system:hours-api", specs/20261112-time-tracking, ADR 20261112-time-bookability-asked-of-owners-meeting-hosts-system-route). Verified via
# AUTH_JWKS_URL; byte-identical to auth's, notify-api's, crm-api's and hours-api's, and DIFFERENT from
# AUTH_AUDIENCE. Optional in the service's own env.ts (unset, every /system request is a 401) but
# required here: without it hours-api cannot name a meeting's deal.
SERVICE_AUDIENCE=${{shared.SERVICE_AUDIENCE}}

# Audio storage — its OWN bucket and credentials (ADR 20260716-eu-object-storage-refund-attachments lineage), private, presigned URLs only.
# ASSUMED to be a Railway S3-compatible bucket on the same EU endpoint as crm-api's — NOT YET
# PROVISIONED: confirm endpoint and region once the bucket exists. MEETINGS_S3_BUCKET and the two
# credential vars (MEETINGS_S3_ACCESS_KEY_ID, MEETINGS_S3_SECRET_ACCESS_KEY) are set by reference to
# the Railway bucket by infra/provision-tool.sh --bucket and deliberately left out of this template.
# The bucket also needs the 29-day lifecycle rule, versioning off and a CORS rule for
# https://operai.welld.io — apply and verify with infra/meetings-bucket-policy.sh BEFORE the first
# deploy, or the startup check refuses to start the service.
MEETINGS_S3_ENDPOINT=https://t3.storageapi.dev
MEETINGS_S3_REGION=ams
MEETINGS_S3_EU_ENDPOINT_HOSTS=t3.storageapi.dev

# AI processing — Google Cloud, ONE dedicated project and ONE service account (specs/20261104-meetings plan
# § Amendment 2026-11-05, ADR 20261105-meetings-ai-providers-google-cloud-eu). Transcription is Cloud Speech-to-Text v2 (Chirp 3, batch) through a
# TRANSIENT EU bucket; summaries and Q&A are Claude on Vertex AI. The Speech and Vertex endpoints are
# DERIVED from the locations below, never configured. Startup refuses (exit 1, value-free message) on a
# location outside the allowlist (`global`, `us`, London are refused), a model id naming fable or mythos,
# a key whose project_id differs from MEETINGS_GCP_PROJECT_ID, an ambient ANTHROPIC_VERTEX_BASE_URL, or a
# transient bucket whose rules do not hold (infra/meetings-gcs-transient-policy.sh --check proves them).
# The retired Azure/Bedrock/AWS variables must NOT be set here: env-doctor flags them.
MEETINGS_SPEECH_LOCATION=eu
MEETINGS_VERTEX_LOCATION=eu
# PLACEHOLDER — replace with the pinned model id once the live prompt-injection eval is green on it
# (specs/20261104-meetings T103/T104, ADR 20261104-meetings-ai-providers-eu-zero-retention/0067). A model change is a deploy that needs a green eval, not a
# variable edit. Never a Fable or Mythos model (Vertex "Advanced AI" logging).
MEETINGS_VERTEX_MODEL_ID=SET-ME-pinned-model-id
# PLACEHOLDERS — NOT YET PROVISIONED. The project id and the transient bucket's name, once the Google
# project and bucket exist (infra/README.md § meetings-api).
MEETINGS_GCP_PROJECT_ID=SET-ME-gcp-project-id
MEETINGS_GCS_TRANSIENT_BUCKET=SET-ME-transient-bucket-name
# SECRET: the runtime service account's JSON key, base64-encoded, from 1Password. Rotate every 90 days.
MEETINGS_GCP_SERVICE_ACCOUNT_KEY=${OP:AIScream/OperAI - Meetings GCP SA/key-base64}

# "real" is REQUIRED in production; "fake" is refused at startup when NODE_ENV=production.
MEETINGS_AI_PROVIDER=real
# The job runner runs in-process (ADR 20261104-durable-job-runner-work-queued-state-derived); "off"/"only" are for a future split of the worker.
MEETINGS_WORKER=on
# MEETINGS_TEST_HOSTS is test-only and is refused in production: it must NOT be set here.

PORT=8085
NODE_ENV=production
