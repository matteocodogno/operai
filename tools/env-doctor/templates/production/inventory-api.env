# env-doctor template — inventory-api (production). See infra/README.md § Variable reference.
# (value taxonomy documented in ./auth.env)
# specs/015-hardware-inventory, T43. inventory-api is a JWKS + authorization-enforcing
# resource server (ADR-0014 lineage) and the FOURTH notify caller (ADR-0044).

DATABASE_URL=postgresql://${{Postgres.PGUSER}}:${{Postgres.PGPASSWORD}}@${{Postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/inventory

# Shell origin only. inventory-ui is a federated remote, so the browser Origin on every
# call is the shell's (ADR-0006); no admin-ui-style direct cross-origin caller exists.
ALLOWED_ORIGINS=https://operai.welld.io

AUTH_ISSUER=https://auth.operai.welld.io
AUTH_JWKS_URL=http://${{auth.RAILWAY_PRIVATE_DOMAIN}}:${{auth.PORT}}/auth/jwks
# Internal CALLS on auth: GET /authz/resolve (ADR-0014), POST /authz/users/identities
# (ADR-0039) and POST /system/service-token (ADR-0044). Private DNS, distinct from AUTH_ISSUER.
AUTH_BASE_URL=http://${{auth.RAILWAY_PRIVATE_DOMAIN}}:${{auth.PORT}}
AUTH_AUDIENCE=${{shared.AUTH_AUDIENCE}}

# notify-api's private address — the shared variable (its ${{notify-api.…}} reference does not
# resolve, see infra/README.md § Private networking). Push goes to POST /system/notifications.
NOTIFY_INTERNAL_URL=${{shared.NOTIFY_INTERNAL_URL}}

# Service-token credentials (ADR-0044). The id must be a key of auth's SERVICE_CLIENTS and the
# secret must equal that entry's secret — env-doctor checks both. The secret is a Railway
# Shared Variable set directly on the project (no 1Password item yet); never commit a value.
# NOTIFY_INTERNAL_TOKEN is deliberately ABSENT: ADR-0040's hard stop (env-doctor errors if set).
SERVICE_CLIENT_ID=inventory-api
SERVICE_CLIENT_SECRET=${{shared.INVENTORY_SERVICE_CLIENT_SECRET}}

# INVENTORY_S3_* — object storage for invoice files (ADR-0016 posture), its OWN bucket and
# credentials, never refund-api's. ASSUMED to be a Railway S3-compatible bucket on the same
# custom, non-AWS endpoint as refund-api's (hence the EU host allowlist) — NOT YET PROVISIONED:
# confirm endpoint and region once the bucket exists, and keep these in sync with the dashboard.
#
# INVENTORY_S3_BUCKET and the two credential vars (INVENTORY_S3_ACCESS_KEY_ID,
# INVENTORY_S3_SECRET_ACCESS_KEY) are set directly on the Railway service and deliberately left
# out of this template, as for refund-api, rather than committed as a fake value. The bucket
# also needs a CORS rule for https://operai.welld.io (POST) — see infra/README.md § Inventory.
INVENTORY_S3_ENDPOINT=https://t3.storageapi.dev
INVENTORY_S3_REGION=ams
INVENTORY_S3_EU_ENDPOINT_HOSTS=t3.storageapi.dev

PORT=8083
NODE_ENV=production
