# env-doctor template — auth (production).
# The exact env you set on the Railway `auth` service. Source of truth for the
# per-service tables in infra/README.md § Variable reference.
#
# Value taxonomy (see tools/env-doctor/README.md):
#   literal            → public identity / browser-facing URL — the doctor CHECKS it
#   ${{railway.ref}}   → Railway reference (internal DNS, or a project Shared Variable)
#   ${OP:vault/item/f} → a 1Password secret; `--resolve` expands it via `op read`
#                        (deliberately NOT literal `op://…` so committed files stay
#                         clear of gitleaks' 1password-reference rule)

DATABASE_URL=postgresql://${{Postgres.PGUSER}}:${{Postgres.PGPASSWORD}}@${{Postgres.RAILWAY_PRIVATE_DOMAIN}}:5432/auth
BETTER_AUTH_SECRET=${OP:Employee/Paperclip - BETTER_AUTH_SECRET/password}

# Public identity — the JWT `iss`; must equal every resource server's AUTH_ISSUER.
BETTER_AUTH_URL=https://auth.operai.welld.io

# Suite-wide constant / shared secret — define ONCE as a Railway project Shared Variable.
AUTH_AUDIENCE=${{shared.AUTH_AUDIENCE}}
NOTIFY_INTERNAL_TOKEN=${{shared.NOTIFY_INTERNAL_TOKEN}}

# Public / browser-facing.
ALLOWED_ORIGINS=https://operai.welld.io
UI_HOME_URL=https://operai.welld.io/

# Internal CALL to notify-api over Railway private networking (http, private DNS, target's PORT).
NOTIFY_INTERNAL_URL=http://${{notify-api.RAILWAY_PRIVATE_DOMAIN}}:${{notify-api.PORT}}

# OAuth + RS256 keypair — 1Password (resolved with --resolve).
GOOGLE_CLIENT_ID=${OP:AIScream/OperAI - GOOGLE OAuth/Client ID}
GOOGLE_CLIENT_SECRET=${OP:AIScream/OperAI - GOOGLE OAuth/Client Secret}
GITHUB_CLIENT_ID=${OP:AIScream/OperAI - GITHUB OAuth/Client ID}
GITHUB_CLIENT_SECRET=${OP:AIScream/OperAI - GITHUB OAuth/Client Secret}
JWT_PRIVATE_KEY=${OP:AIScream/OperAI Private Key/private key}
JWT_PUBLIC_KEY=${OP:AIScream/OperAI Private Key/public key}

# Operator-set: the first admin (specs/004 AC-6.1). Not secret; edit to the real account.
BOOTSTRAP_ADMIN_EMAIL=admin@welld.ch

# Set explicitly so private-networking callers can reference ${{auth.PORT}}.
PORT=3001
NODE_ENV=production
