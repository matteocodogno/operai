# accounting-api — local environment (specs/20261119-accounting, ADR 20261119-accounting-reference-data-belongs-to-accounting-api-…).
# Copy to .env and fill in. Never commit the filled-in copy.

# ─── Database ─────────────────────────────────────────────────────────────────
# Shared local Postgres (compose.yaml, host port 5435), logical database `accounting`.
# The test suite TRUNCATEs its tables: point DATABASE_URL at a throwaway database before
# `bun test` (the CI service, or an isolated container), never at data you want to keep.
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/accounting

# ─── HTTP ─────────────────────────────────────────────────────────────────────
# The browser calls accounting-api from the SHELL's origin (the accounting remote runs
# inside it), so :5173 is required; add :5183 only to run accounting-ui standalone.
# A wildcard is refused at startup.
ALLOWED_ORIGINS=http://localhost:5173
PORT=8089
NODE_ENV=development

# ─── Identity (JWKS resource server, ADR 20260703-jwt-resource-server-remote-jwks) ─────────────────────────────
# Same values as crm-api / projects-api.
AUTH_JWKS_URL=http://localhost:3001/auth/jwks
AUTH_ISSUER=http://localhost:3001
AUTH_AUDIENCE=<same as projects-api AUTH_AUDIENCE>
# `auth` itself: GET /authz/resolve (the caller's accounting grants, forwarded Bearer).
AUTH_BASE_URL=http://localhost:3001

# ─── Service credentials accepted on /system/v1/* (refund-api reads reference data) ─────────────
# The `aud` of the scoped service JWTs `auth` mints (`POST /system/service-token`): equal to auth's
# SERVICE_AUDIENCE and DIFFERENT from AUTH_AUDIENCE (startup refuses equal values).
# auth's SERVICE_CLIENTS entry for refund-api carries the scope `accounting.reference.read`.
SERVICE_AUDIENCE=operai-service

# ─── Monthly exchange rates (ADR 20261118-monthly-exchange-rates-are-fetched-on-demand-…) ─────────────────────
# `bazg` (default): fetch the federal monthly average rates on demand from the one fixed BAZG host.
# `off`: never call out; every attempt is recorded as `disabled` and rates are typed by hand (offline dev, e2e).
ACCOUNTING_FX_SOURCE=bazg
