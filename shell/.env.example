# shell environment variables
# Copy to .env.local and fill in values for local development.
# Never commit .env.local or any file with real secrets.

# URL of the Operai auth service.
# Local default: the auth service started via `bun run dev` in the auth/ directory.
# Production: set to the deployed auth service URL (e.g. https://auth.operai.io).
# Required by the shell's `_authed` guard (src/router.tsx, T9) to build the
# hosted sign-in redirect, and by shell/session (T4) to fetch/refresh the JWT.
VITE_AUTH_URL=http://localhost:3001

# URL of the estimai-api backend service.
# Local default: the estimai-api service started via `bun run dev` in the estimai-api/ directory.
# Production: set to the deployed API URL (e.g. https://api.estimai.operai.io).
# Consumed by shell/session's trusted-origin allowlist (T4) — remotes attach
# the shared Bearer JWT only to requests targeting this origin (or VITE_AUTH_URL,
# or same-origin).
VITE_API_URL=http://localhost:8080

# URL of the notify-api backend service (specs/005-notification-center).
# Local default: the notify-api service started via `bun run dev` in the notify-api/ directory.
# Production: set to the deployed notify-api URL (e.g. https://notify-api.operai.welld.io).
# Consumed by shell/session's trusted-origin allowlist (T10) and getNotifyBaseUrl() —
# the raise-capability, useUnreadCount SSE manager, and notify-ui's own calls all
# build notify-api URLs against this origin, mirroring VITE_API_URL/VITE_AUTH_URL above.
VITE_NOTIFY_API_URL=http://localhost:8081

# URL of the refund-api backend service (specs/007-refund-service).
# Local default: the refund-api service started via `bun run dev` in the refund-api/ directory.
# Production: set to the deployed refund-api URL (EU region — data residency,
# CLAUDE.md), e.g. https://refund-api.operai.welld.io.
# Consumed by shell/session's trusted-origin allowlist (T20) — refund-ui's own
# calls (refund-ui/src/lib/refundApi.ts, which already reads its OWN
# VITE_REFUND_API_URL and goes through apiFetch) only get the Bearer JWT
# attached once this SAME origin is also trusted here. Mirrors
# VITE_NOTIFY_API_URL above exactly.
VITE_REFUND_API_URL=http://localhost:8082

# Runtime remoteEntry.js URLs for the suite's federated tools (T9, mirrors the
# retired seed remote's SEED_REMOTE_URL pattern). These are read in
# vite.config.ts via `process.env`, NOT `import.meta.env` — they configure
# Vite itself (Node-side), not client code, so they are plain env vars, not
# VITE_-prefixed. Dev-only defaults are baked into vite.config.ts; set these
# to point at wherever estimai-ui/refund-ui are actually being served.
# ESTIMAI_REMOTE_URL=http://localhost:5174/remoteEntry.js
# REFUND_REMOTE_URL=http://localhost:5176/remoteEntry.js

# T17 (specs/003-suite-shell, AC-5.3): the two vars above are BUILD-TIME
# defaults, baked into the shell's JS bundle at `vite build`. In production,
# shell/public/runtime-config.json (see runtime-config.example.json — the
# real file is intentionally NOT committed) is fetched at RUNTIME (every page
# load, cache: 'no-store') and, if present, OVERRIDES these build-time values
# via @module-federation/runtime's registerRemotes({ force: true }) — see
# src/lib/runtimeRemotes.ts. This lets a remote's origin be repointed without
# rebuilding the shell. If runtime-config.json is absent (the default — local
# dev, the T16 e2e suite, and any production deploy that hasn't opted in),
# the build-time values above are what's actually used, unchanged.
