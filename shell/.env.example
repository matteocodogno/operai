# shell environment variables
# Copy to .env.local and fill in values for local development.
# Never commit .env.local or any file with real secrets.

# URL of the Operai auth service.
# Local default: the auth service started via `bun run dev` in the auth/ directory.
# Production: set to the deployed auth service URL (e.g. https://auth.operai.io).
# Required by the shell's `_authed` guard (src/router.tsx, T9) to build the
# hosted sign-in redirect, and by shell/session (T4) to fetch/refresh the JWT.
VITE_AUTH_URL=http://localhost:3001

# URL of the estimai-api backend service.
# Local default: the estimai-api service started via `bun run dev` in the estimai-api/ directory.
# Production: set to the deployed API URL (e.g. https://api.estimai.operai.io).
# Consumed by shell/session's trusted-origin allowlist (T4) — remotes attach
# the shared Bearer JWT only to requests targeting this origin (or VITE_AUTH_URL,
# or same-origin).
VITE_API_URL=http://localhost:8080

# Runtime remoteEntry.js URLs for the suite's federated tools (T9, mirrors the
# retired seed remote's SEED_REMOTE_URL pattern). These are read in
# vite.config.ts via `process.env`, NOT `import.meta.env` — they configure
# Vite itself (Node-side), not client code, so they are plain env vars, not
# VITE_-prefixed. Dev-only defaults are baked into vite.config.ts; set these
# to point at wherever estimai-ui/refund-ui are actually being served.
# ESTIMAI_REMOTE_URL=http://localhost:5174/remoteEntry.js
# REFUND_REMOTE_URL=http://localhost:5176/remoteEntry.js
