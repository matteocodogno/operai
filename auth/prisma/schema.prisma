generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Better Auth core tables ──────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // ─── Authorization (spec 004) ──────────────────────────────────────────────
  // permissionEpoch is bumped (in the same tx as any authz mutation affecting
  // this user) so live consumers (GET /authz/me, and — in a future backend —
  // the JWT perm_epoch claim) can detect a stale cached permission view.
  // entity/jobTitle are admin-set attribute targets for ABAC conditions
  // (see PermissionRule.conditions).
  permissionEpoch Int     @default(0)
  entity          String?
  jobTitle        String?

  // ─── Soft delete (spec 006-user-invitations, T4/T7 — AC-5.x) ───────────────
  // null = active; set = soft-deleted. Nullable with NO default (R7): a
  // migration adding this column performs no backfill/rewrite of existing
  // rows, which all continue to read as active. Deletion in this feature is
  // ALWAYS soft — the row, its Account rows, and its UserRole/UserDepartment
  // rows are retained (see ADR-0012); resource servers do nothing at delete
  // time. `deletedByUserId` is a plain audit convenience column (the
  // authoritative record is the `audit_log` row written by the delete
  // transaction) — deliberately NOT a FK relation, so a deleted actor never
  // blocks referential integrity here.
  deletedAt       DateTime?
  deletedByUserId String?

  sessions Session[]
  accounts Account[]

  userRoles       UserRole[]
  userDepartments UserDepartment[]
  auditLogs       AuditLog[]

  // ─── Employee address (specs/012-employee-address, ADR-0031) ───────────────
  // 1:1, optional — row absence IS "no address on file" (Domain language).
  address EmployeeAddress?

  // ─── Invitations (spec 006-user-invitations, T4) ───────────────────────────
  invitationsSent     Invitation[] @relation("InvitationInviter")
  invitationsAccepted Invitation[] @relation("InvitationAcceptor")

  @@index([deletedAt])
  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ─── Better Auth jwt plugin — rotating RS256 keypair storage ─────────────────x

model Jwks {
  id         String   @id @default(cuid())
  publicKey  String
  privateKey String
  createdAt  DateTime @default(now())

  @@map("jwks")
}

// ─── Authorization domain (spec 004) ─────────────────────────────────────────
// Hand-rolled RBAC/ABAC — see docs/adr/0007. Roles bundle permission_rules;
// departments confer roles to their members; users hold roles directly and/or
// via department membership. Effective permissions = union of both paths,
// resolved live (never embedded in the JWT — see auth.config.ts definePayload).

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rules           PermissionRule[]
  userRoles       UserRole[]
  departmentRoles DepartmentRole[]

  @@map("role")
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  departmentRoles DepartmentRole[]
  members         UserDepartment[]

  @@map("department")
}

// A grant of one action on one resource, optionally narrowed by conditions
// (ownership + attribute match — see docs). Rules bundle into a role.
model PermissionRule {
  id     String @id @default(cuid())
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  resource   String
  action     String
  // { ownership: "own"|"any", attributes: [{ key, match: "user" }] } — see plan.md
  conditions Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
  @@index([resource, action])
  @@map("permission_rule")
}

// Direct role assignment to a user.
model UserRole {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedByUserId String?
  assignedAt       DateTime @default(now())

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_role")
}

// Roles a department confers to all of its members.
model DepartmentRole {
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([departmentId, roleId])
  @@index([roleId])
  @@map("department_role")
}

// Department membership — members inherit the department's roles.
model UserDepartment {
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  assignedByUserId String?
  assignedAt       DateTime @default(now())

  @@id([userId, departmentId])
  @@index([departmentId])
  @@map("user_department")
}

// A resource an app protects (an app itself, or a data type within it).
// appId is the declaring app (e.g. "estimai"); key is the resource
// (e.g. "estimate", or the app id itself for the app-access resource).
model CatalogResource {
  id    String @id @default(cuid())
  appId String
  key   String
  label String

  actions CatalogAction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([appId, key])
  @@map("catalog_resource")
}

// An operation on a catalog resource (view/create/edit/delete/approve/access)
// and which condition types a rule against it may use.
model CatalogAction {
  id         String          @id @default(cuid())
  resourceId String
  resource   CatalogResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  key                 String
  label               String
  supportedConditions String[]

  @@unique([resourceId, key])
  @@index([resourceId])
  @@map("catalog_action")
}

// Immutable authorization-change trail (AC-5.1/5.3) — no update/delete route.
// actorUserId is nullable + SetNull so the record survives the actor's deletion.
model AuditLog {
  id String @id @default(cuid())

  actorUserId String?
  actor       User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  action     String
  targetType String
  targetId   String?
  summary    String
  // before/after diff, shape varies by action
  data       Json?

  createdAt DateTime @default(now())

  @@index([actorUserId])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_log")
}

// ─── Employee address (specs/012-employee-address, ADR-0031) ─────────────────
// Employee home address (specs/012). One current address per user, or none —
// the ROW's existence is the "address on file" flag (Domain language). There
// is deliberately no history table: superseded values live only in
// `audit_log` (US-5, via the same `withAudit` mechanism ADR-0033 leaves
// entirely unchanged — this model has NO relation to AuditLog and this
// migration touches no column, FK, or `onDelete` behaviour of `audit_log`).
// Cascades on user delete; production deletion is soft (ADR-0012), so this
// only ever fires for hard deletes (tests/fixtures).
model EmployeeAddress {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The four REQUIRED structured components (AC-1.4). NOT NULL *is* the
  // "all four or none" guarantee (ADR-0031 Decision point 2).
  countryCode String // ISO 3166-1 alpha-2, upper-case; CHECK ~ '^[A-Z]{2}$'
  city        String
  street      String
  houseNumber String // a STRING: "12b", "1/A", "s.n.c." are all real

  // OPTIONAL components — never a reason a save is rejected (AC-1.4).
  postalCode String?
  region     String? // canton / state / province / administrative_area_level_1

  // Coordinates — captured ONLY from a selected suggestion (AC-2.5), cleared
  // on a subsequent hand-edit (AC-2.6). Both-or-neither, enforced by CHECK.
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  // Plain column, deliberately NOT a FK — same reasoning as
  // User.deletedByUserId: the authoritative record is the audit_log row.
  updatedByUserId String?

  @@map("employee_address")
}

// ─── Invitations (spec 006-user-invitations) ─────────────────────────────────
// Invitation lifecycle: see docs/adr/0012 (activation hooks + soft-delete) and
// docs/adr/0013 (derived `expired` state, schedulerless). Stored `status` is
// only ever `pending | accepted | revoked` — `expired` is ALWAYS computed
// (`status=='pending' && expiresAt<=now`, see src/invitations/), never a
// literal value written here in the routine hot path. `roleIds`/
// `departmentIds` are the assignment snapshot taken at invite-create time
// (validated then; immutable thereafter — no in-place edit).
model Invitation {
  id            String   @id @default(cuid())
  email         String // normalized lower-case
  status        String   @default("pending") // pending | accepted | revoked
  roleIds       String[]
  departmentIds String[]
  tokenHash     String // sha256(raw link token); rotated on resend

  expiresAt DateTime // created/last-resend + 72h

  invitedByUserId String?
  invitedBy       User?   @relation("InvitationInviter", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  acceptedByUserId String?
  acceptedBy       User?   @relation("InvitationAcceptor", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  lastEmailStatus String? // sent | failed
  lastEmailError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@map("invitation")
}

// NOTE: a partial unique index enforcing "at most one LIVE pending invitation
// per email" (AC-1.4) — `CREATE UNIQUE INDEX invitation_pending_email_key ON
// invitation (email) WHERE status = 'pending'` — cannot be expressed in the
// Prisma schema language (no partial-index support). It is appended as raw
// SQL to the migration this model was introduced in
// (prisma/migrations/*_invitation_lifecycle/migration.sql) — see ADR-0013.
