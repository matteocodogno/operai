generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Better Auth core tables ──────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // ─── Authorization (spec 004) ──────────────────────────────────────────────
  // permissionEpoch is bumped (in the same tx as any authz mutation affecting
  // this user) so live consumers (GET /authz/me, and — in a future backend —
  // the JWT perm_epoch claim) can detect a stale cached permission view.
  // entity/jobTitle are admin-set attribute targets for ABAC conditions
  // (see PermissionRule.conditions).
  permissionEpoch Int     @default(0)
  entity          String?
  jobTitle        String?

  // ─── Soft delete (spec 20260713-user-invitations, T4/T7 — AC-5.x) ───────────────
  // null = active; set = soft-deleted. Nullable with NO default (R7): a
  // migration adding this column performs no backfill/rewrite of existing
  // rows, which all continue to read as active. Deletion in this feature is
  // ALWAYS soft — the row, its Account rows, and its UserRole/UserDepartment
  // rows are retained (see ADR 20260714-invitation-activation-hooks-soft-delete-lifecycle); resource servers do nothing at delete
  // time. `deletedByUserId` is a plain audit convenience column (the
  // authoritative record is the `audit_log` row written by the delete
  // transaction) — deliberately NOT a FK relation, so a deleted actor never
  // blocks referential integrity here.
  deletedAt       DateTime?
  deletedByUserId String?

  sessions Session[]
  accounts Account[]

  userRoles       UserRole[]
  userDepartments UserDepartment[]
  auditLogs       AuditLog[]

  // ─── Employee address (specs/20260803-employee-address, ADR 20260804-employee-address-auth-identity-attribute-1to1-table) ───────────────
  // 1:1, optional — row absence IS "no address on file" (Domain language).
  address EmployeeAddress?

  // ─── Invitations (spec 20260713-user-invitations, T4) ───────────────────────────
  invitationsSent     Invitation[] @relation("InvitationInviter")
  invitationsAccepted Invitation[] @relation("InvitationAcceptor")

  // ─── Access requests (specs/20261105-signup-gate, ADR 20261105-access-only-by-invitation-waiting-list) ─────────────────────────────────
  accessRequestsDecided AccessRequest[] @relation("AccessRequestDecider")

  // ─── Teams (specs/20261126-teams) ───────────────────────────────────────────────
  // A team grants nothing: the permission resolver never reads these rows (AC-2.5).
  teamMemberships TeamMember[]

  @@index([deletedAt])
  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("verification")
}

// ─── Better Auth jwt plugin — rotating RS256 keypair storage ─────────────────x

model Jwks {
  id         String   @id @default(cuid())
  publicKey  String
  privateKey String
  createdAt  DateTime @default(now())
  // better-auth >= 1.7 jwt plugin: optional key expiry + algorithm/curve of the
  // stored key. Nullable, so rows written by 1.6 stay valid.
  expiresAt  DateTime?
  alg        String?
  crv        String?

  @@map("jwks")
}

// ─── Authorization domain (spec 004) ─────────────────────────────────────────
// Hand-rolled RBAC/ABAC — see docs/adr/0007. Roles bundle permission_rules;
// departments confer roles to their members; users hold roles directly and/or
// via department membership. Effective permissions = union of both paths,
// resolved live (never embedded in the JWT — see auth.config.ts definePayload).

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rules           PermissionRule[]
  userRoles       UserRole[]
  departmentRoles DepartmentRole[]

  @@map("role")
}

model Department {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  departmentRoles DepartmentRole[]
  members         UserDepartment[]

  @@map("department")
}

// A named group of users (specs/20261126-teams). Grants NOTHING: the resolver never reads it (AC-2.5).
// The case-insensitive unique name index and the shape CHECKs are in the migration's SQL (Prisma cannot express them).
model Team {
  id          String    @id @default(cuid())
  name        String // trimmed, 1..80; unique case-insensitively (index team_name_lower_key)
  description String? // <= 500; an empty description is stored as NULL
  archivedAt  DateTime? // null = active; a team is archived, never deleted (AC-1.7)
  version     Int       @default(1) // name, description and state only
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  members TeamMember[]

  @@map("team")
}

model TeamMember {
  teamId        String
  team          Team     @relation(fields: [teamId], references: [id], onDelete: Restrict)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade) // users are soft-deleted; Cascade only for hard test cleanup
  addedByUserId String? // convenience, no FK: the audit row is authoritative (as User.deletedByUserId)
  addedAt       DateTime @default(now())

  @@id([teamId, userId])
  @@index([userId])
  @@map("team_member")
}

// A grant of one action on one resource, optionally narrowed by conditions
// (ownership + attribute match — see docs). Rules bundle into a role.
model PermissionRule {
  id     String @id @default(cuid())
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  resource   String
  action     String
  // { ownership: "own"|"any", attributes: [{ key, match: "user" }] } — see plan.md
  conditions Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roleId])
  @@index([resource, action])
  @@map("permission_rule")
}

// Direct role assignment to a user.
model UserRole {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  assignedByUserId String?
  assignedAt       DateTime @default(now())

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_role")
}

// Roles a department confers to all of its members.
model DepartmentRole {
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([departmentId, roleId])
  @@index([roleId])
  @@map("department_role")
}

// Department membership — members inherit the department's roles.
model UserDepartment {
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  departmentId String
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)

  assignedByUserId String?
  assignedAt       DateTime @default(now())

  @@id([userId, departmentId])
  @@index([departmentId])
  @@map("user_department")
}

// A resource an app protects (an app itself, or a data type within it).
// appId is the declaring app (e.g. "estimai"); key is the resource
// (e.g. "estimate", or the app id itself for the app-access resource).
model CatalogResource {
  id    String @id @default(cuid())
  appId String
  key   String
  label String

  actions CatalogAction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([appId, key])
  @@map("catalog_resource")
}

// An operation on a catalog resource (view/create/edit/delete/approve/access)
// and which condition types a rule against it may use.
model CatalogAction {
  id         String          @id @default(cuid())
  resourceId String
  resource   CatalogResource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  key                 String
  label               String
  supportedConditions String[]

  @@unique([resourceId, key])
  @@index([resourceId])
  @@map("catalog_action")
}

// Immutable authorization-change trail (AC-5.1/5.3) — no update/delete route.
// actorUserId is nullable + SetNull so the record survives the actor's deletion.
model AuditLog {
  id String @id @default(cuid())

  actorUserId String?
  actor       User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  action     String
  targetType String
  targetId   String?
  summary    String
  // before/after diff, shape varies by action
  data       Json?

  createdAt DateTime @default(now())

  @@index([actorUserId])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_log")
}

// ─── Employee address (specs/20260803-employee-address, ADR 20260804-employee-address-auth-identity-attribute-1to1-table) ─────────────────
// Employee home address (specs/20260803-employee-address). One current address per user, or none —
// the ROW's existence is the "address on file" flag (Domain language). There
// is deliberately no history table: superseded values live only in
// `audit_log` (US-5, via the same `withAudit` mechanism ADR 20260804-two-tier-audit-assurance-auth-audit-log-application-level leaves
// entirely unchanged — this model has NO relation to AuditLog and this
// migration touches no column, FK, or `onDelete` behaviour of `audit_log`).
// Cascades on user delete; production deletion is soft (ADR 20260714-invitation-activation-hooks-soft-delete-lifecycle), so this
// only ever fires for hard deletes (tests/fixtures).
model EmployeeAddress {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The four REQUIRED structured components (AC-1.4). NOT NULL *is* the
  // "all four or none" guarantee (ADR 20260804-employee-address-auth-identity-attribute-1to1-table Decision point 2).
  countryCode String // ISO 3166-1 alpha-2, upper-case; CHECK ~ '^[A-Z]{2}$'
  city        String
  street      String
  houseNumber String // a STRING: "12b", "1/A", "s.n.c." are all real

  // OPTIONAL components — never a reason a save is rejected (AC-1.4).
  postalCode String?
  region     String? // canton / state / province / administrative_area_level_1

  // Coordinates — captured ONLY from a selected suggestion (AC-2.5), cleared
  // on a subsequent hand-edit (AC-2.6). Both-or-neither, enforced by CHECK.
  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  // Plain column, deliberately NOT a FK — same reasoning as
  // User.deletedByUserId: the authoritative record is the audit_log row.
  updatedByUserId String?

  @@map("employee_address")
}

// ─── Invitations (spec 20260713-user-invitations) ─────────────────────────────────
// Invitation lifecycle: see docs/adr/0012 (activation hooks + soft-delete) and
// docs/adr/0013 (derived `expired` state, schedulerless). Stored `status` is
// only ever `pending | accepted | revoked` — `expired` is ALWAYS computed
// (`status=='pending' && expiresAt<=now`, see src/invitations/), never a
// literal value written here in the routine hot path. `roleIds`/
// `departmentIds` are the assignment snapshot taken at invite-create time
// (validated then; immutable thereafter — no in-place edit).
model Invitation {
  id            String   @id @default(cuid())
  email         String // normalized lower-case
  status        String   @default("pending") // pending | accepted | revoked
  roleIds       String[]
  departmentIds String[]
  tokenHash     String // sha256(raw link token); rotated on resend

  expiresAt DateTime // created/last-resend + 72h

  invitedByUserId String?
  invitedBy       User?   @relation("InvitationInviter", fields: [invitedByUserId], references: [id], onDelete: SetNull)

  acceptedByUserId String?
  acceptedBy       User?   @relation("InvitationAcceptor", fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  accessRequests AccessRequest[]

  lastEmailStatus String? // sent | failed
  lastEmailError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@map("invitation")
}

// specs/20261105-signup-gate (ADR 20261105-access-only-by-invitation-waiting-list). The waiting list. Not a user: grants nothing.
// CHECK constraints on status/provider live in the migration SQL.
model AccessRequest {
  id               String      @id @default(cuid())
  email            String      @unique // lower-case
  name             String
  provider         String // google | github | unknown
  status           String      @default("pending") // pending | approved | rejected
  firstRequestedAt DateTime    @default(now())
  requestedAt      DateTime    @default(now()) // last attempt
  decidedAt        DateTime?
  decidedByUserId  String?
  decidedBy        User?       @relation("AccessRequestDecider", fields: [decidedByUserId], references: [id], onDelete: SetNull)
  invitationId     String?
  invitation       Invitation? @relation(fields: [invitationId], references: [id], onDelete: SetNull)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([status, requestedAt])
  @@map("access_request")
}

// NOTE: a partial unique index enforcing "at most one LIVE pending invitation
// per email" (AC-1.4) — `CREATE UNIQUE INDEX invitation_pending_email_key ON
// invitation (email) WHERE status = 'pending'` — cannot be expressed in the
// Prisma schema language (no partial-index support). It is appended as raw
// SQL to the migration this model was introduced in
// (prisma/migrations/*_invitation_lifecycle/migration.sql) — see ADR 20260714-invitation-lifecycle-derived-expiry-state.

/// One version of one legal entity's details (specs/20261117-legal-entities). Append-only: the migration's
/// trigger refuses UPDATE, DELETE and TRUNCATE (Tier 1, ADR 20261117-legal-entity-registry-in-auth-is-append-only-versions-immutable-in-the-database).
/// The current details are the highest version. CHECK constraints and triggers live in the migration SQL.
model LegalEntityVersion {
  entity          String // CHECK in ('welld_it','welld_ch')
  version         Int // CHECK >= 1; contiguous per entity (advisory lock + PK)
  legalName       String // '' = empty; never null
  addressIt       String[] // lines, no blank line
  addressEn       String[]
  vatNumber       String
  iban            String // electronic form: upper case, no spaces ('' = empty)
  contactsIt      String
  contactsEn      String
  action          String // CHECK in ('import','save','restore')
  restoredFrom    Int? // CHECK (action = 'restore') = (restoredFrom IS NOT NULL) AND restoredFrom < version
  changedFields   String[] // closed set: legalName, address.it, address.en, vatNumber, iban, contacts.it, contacts.en
  createdByUserId String? // null = the system (the move); plain column, not a FK (User.deletedByUserId convention)
  createdByName   String? // the person's name at the save; null for the system
  createdAt       DateTime @default(now())

  notices LegalEntityNotice[]

  @@id([entity, version])
  @@map("legal_entity_version")
}

/// The duty to tell people about one protected change (specs/20261117-legal-entities US-9, plan G4). One row per
/// (version, recipient, channel), written in the transaction that stores the version (T58); the dispatcher (T59)
/// sends and updates the status columns. Tier 2 like `audit_log` (ADR 20260804-two-tier-audit-assurance-auth-audit-log-application-level):
/// rows change status, so there is no immutability trigger; the version it refers to is Tier 1 and cannot go while a
/// notice names it (FK RESTRICT). It holds NO value of any detail (AC-9.12): content is rebuilt from the immutable
/// versions at send time, and the outside address is never stored (read from the environment at send time). The one
/// personal value it holds is the author's account email (`authorEmail`, amendment D9).
/// CHECK constraints live in the migration SQL.
model LegalEntityNotice {
  id            String    @id @default(cuid())
  entity        String
  version       Int
  recipient     String // a user id (plain column, like createdByUserId), or "outside"
  recipientKind String // CHECK in ('person','outside'); (kind = 'outside') = (recipient = 'outside')
  channel       String // CHECK in ('in_app','email'); an outside recipient is email only
  status        String    @default("pending") // CHECK in ('pending','delivered','given_up')
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  leaseUntil    DateTime?
  lastReason    String? // closed set, plan G4 (notify_unreachable, notify_refused, ...)
  firstFailedAt DateTime?
  deliveredAt   DateTime?
  givenUpAt     DateTime?
  createdAt     DateTime  @default(now()) // = the version's createdAt (the transaction time), set by the writer
  /// The actor's account email when the version was stored (AC-9.11, amendment D9); null = none on record.
  /// Personal data: content of the notice only; never in a log line or an audit entry. Written once at capture, cleared once at the terminal status
  /// (delivered / given_up, D9-1; a trigger allows no other change), never otherwise updated.
  /// CHECK not empty (no CHECK on the form: a failing CHECK must not turn a valid save into a 500).
  authorEmail   String?

  legalEntityVersion LegalEntityVersion @relation(fields: [entity, version], references: [entity, version], onDelete: Restrict)

  @@unique([entity, version, recipient, channel])
  @@index([status, nextAttemptAt])
  @@map("legal_entity_notice")
}
