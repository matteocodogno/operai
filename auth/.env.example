# ─── Better Auth ─────────────────────────────────────────────────────────────
# Must be at least 32 random characters
BETTER_AUTH_SECRET=change-me-to-a-secure-random-string-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3001

# ─── Google OAuth ────────────────────────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── GitHub OAuth ────────────────────────────────────────────────────────────
# https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── RS256 JWT Key Pair ───────────────────────────────────────────────────────
# Generate with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Paste the PEM contents with literal \n for newlines:
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----"

# ─── JWT audience (ADR-0010, specs/005-notification-center T8) ──────────────
# Stamped as the standard `aud` claim on every JWT this service mints (the jwt
# plugin's `definePayload`, auth/src/auth/auth.config.ts) — NOT a secret, a
# suite-wide config identifier. Closes the cross-service JWT-replay gap now
# that notify-api is the suite's first real second JWKS resource server
# (a token minted for one resource server was, until now, structurally valid
# on any other — see ADR-0010).
# v1 is ONE shared value for every current resource server (estimai-api,
# notify-api) — not yet a per-service audience (ADR-0010 "Consequences").
# CRITICAL: this value MUST be byte-for-byte identical to the `AUTH_AUDIENCE`
# each resource server's `jwtMiddleware` verifies against (T9) — a drifted
# value fails every request closed (401) in that environment. Treat it as a
# single constant documented alongside AUTH_ISSUER/AUTH_JWKS_URL wherever
# resource-server env vars are set (infra/README.md), not a bespoke
# per-service value.
AUTH_AUDIENCE=operai-suite

# ─── CORS ─────────────────────────────────────────────────────────────────────
# This list feeds BOTH the Hono CORS layer AND better-auth's `trustedOrigins`
# (which gates session-mutating calls like /auth/sign-out). Set it to the real
# UI origin(s) in each environment; no wildcards.
# SECURITY: do NOT set `BETTER_AUTH_TRUSTED_ORIGINS` — better-auth appends that
# env var to its trusted list at runtime, bypassing this validated allowlist.
# Leave it unset so ALLOWED_ORIGINS stays the single source of origin trust.
#
# specs/003-suite-shell (T17, ADR-0002, ADR-0006): the `shell` app is now the
# suite's single entry point and the ONLY origin that calls `getSession()` /
# `GET /auth/token` / `signOut()` in production — estimai-ui and refund-ui run
# as federated remotes INSIDE the shell's page and delegate every session call
# to the shared `shell/session` module (no independent auth guard of their
# own, see ADR-0006). This means the PRODUCTION value of ALLOWED_ORIGINS only
# needs the shell's origin, not estimai-ui's or refund-ui's own origins:
#   ALLOWED_ORIGINS=https://operai.welld.io
# (https://operai.welld.io is the shell's production origin per
# infra/README.md — it was estimai-ui's standalone origin before the suite
# shell; the custom domain is reassigned to the shell project). REQUIRED
# PRODUCTION STEP: this repo cannot set the real ALLOWED_ORIGINS value for you —
# a human must set the deployed auth service's env var (see infra/README.md
# § Phase 3 / Variable reference) to the shell's real production origin before
# the shell can authenticate.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Post-login redirect fallback ────────────────────────────────────────────
# Absolute URL of the EstimAI home page. Used as the post-login destination
# when the sign-in `redirect` param is absent or fails origin validation
# (AC-1.3). Must be a URL whose origin is listed in ALLOWED_ORIGINS.
UI_HOME_URL=http://localhost:5173

# ─── notify-api internal email channel (specs/006-user-invitations, ADR-0011) ─
# Triggers the invite/resend email from the invitation admin API
# (src/lib/notify.ts → notify-api's internal, NON-user-JWT endpoint
# POST /system/emails). Two reused vars feed the email templates instead of
# new ones: BETTER_AUTH_URL above is the invite-link base
# (`${BETTER_AUTH_URL}/invite?id=...&token=...`) and UI_HOME_URL above is the
# post-accept redirect — both already declared, nothing new to add for those.
#
# NOTIFY_INTERNAL_URL: notify-api's base URL for the internal call.
# Local dev: notify-api's own dev port (see notify-api/.env.example PORT).
# Production (Railway): point this at notify-api's PRIVATE-networking
# hostname (`http://notify-api.railway.internal:<notify-api PORT>`), NOT its
# public *.operai.welld.io domain — plan.md Risk R2 / ADR-0011 require this
# service-to-service call to stay off the public internet. See
# infra/README.md § Variable reference for the exact Railway reference syntax.
NOTIFY_INTERNAL_URL=http://localhost:8081

# ─── App-access eligibility check (specs/013-estimate-sharing, T1/T2, ───────
# ADR-0035) — has defaults, documented here for completeness (T13) ──────────
#
# `POST /authz/app-access-check` lets any signed-in end user (holding their
# own JWT, and gated on holding `(appId,"access")` themselves) ask whether
# ANOTHER user is eligible to be added as a collaborator — a decision
# endpoint, not a fact endpoint (ADR-0035): both "no such user" and "user
# exists but lacks app access" return the exact same `{eligible:false}` body,
# on the exact same code path, in the exact same minimum wall-clock time, so
# neither a bad guess nor a real-but-ineligible email can be told apart by a
# caller. FLOOR is that minimum time (ms) EVERY `eligible:false` response
# takes regardless of which cause produced it; the success path is not
# floored. RATE_LIMIT/_WINDOW_MS bound this directly-callable surface
# (sliding-window in-process, src/lib/rateLimiter.ts) — the first rate
# limiter in the suite. All three have defaults below and are OPTIONAL to set
# explicitly; override only to tune for a specific environment.
APP_ACCESS_CHECK_FLOOR_MS=150
APP_ACCESS_CHECK_RATE_LIMIT=40
APP_ACCESS_CHECK_RATE_WINDOW_MS=600000

# ─── Identity-resolution rate limit (specs/013-estimate-sharing, T27, ───────
# resolves T3 drift) — has defaults, documented here for completeness (T13) ─
#
# `POST /authz/users/identities` (T3, ADR-0039) resolves display identity
# (id → name/status) for the owner + collaborators of a shared estimate —
# id-keyed, caller-scoped, no email/name/query/prefix search, so it leaks no
# existence signal the caller doesn't already hold (unlike app-access-check
# above) and therefore needs NO response-time floor. It still needs a rate
# limit to bound the worst-case 100-id fan-out per call — reuses the SAME
# rateLimiter.ts module as APP_ACCESS_CHECK above (a second limiter instance,
# not a second implementation), keyed per caller `sub`. 120/10min sits far
# above real usage (roughly one batched call per estimates-list render).
# Both have defaults below and are OPTIONAL to set explicitly.
IDENTITIES_RATE_LIMIT=120
IDENTITIES_RATE_WINDOW_MS=600000

# ─── User directory rate limit (specs/015-hardware-inventory, T5; ADR-0047) ─
# `GET /authz/users/directory` lists active users to holders of the inventory
# `asset:manage` permission (the assign picker). Gated by that permission, not
# floored; this bounds how often a holder can pull the roster. Keyed per caller
# `sub`, counted on every attempt. Defaults shown; OPTIONAL to set.
DIRECTORY_RATE_LIMIT=60
DIRECTORY_RATE_WINDOW_MS=600000

# ─── Service tokens (specs/015-hardware-inventory, T4; ADR-0044) ────────────
# `POST /system/service-token` lets a SERVICE (today: inventory-api) swap a
# per-client secret for a 5-minute RS256 JWT that notify-api accepts on
# `POST /system/notifications` only. Both variables are OPTIONAL: with no
# clients configured the endpoint authenticates nobody (every call is 401) and
# the service starts as before.
#
# SERVICE_AUDIENCE — the `aud` of those tokens. MUST differ from AUTH_AUDIENCE
# (startup exits otherwise) so a service token is never valid on a user route
# and a user JWT never valid on a system route. MUST equal notify-api's own
# SERVICE_AUDIENCE. Required whenever SERVICE_CLIENTS is set.
#
# SERVICE_CLIENTS — JSON object keyed by client id; the key becomes the token
# `sub` as `system:<clientId>`. Each entry: `secret` (32-256 chars, generate with
# `openssl rand -base64 48`) and `scope` (space-delimited; the only scope that
# exists today is `notifications.push`). This holds SECRETS: in local dev keep a
# throwaway value; in real environments it lives in 1Password / the deploy
# environment only. The matching client side is inventory-api's
# SERVICE_CLIENT_ID + SERVICE_CLIENT_SECRET (same id and secret as the entry).
# To revoke a client, remove its entry (issued tokens expire within 5 minutes).
# SERVICE_AUDIENCE=operai-service
# SERVICE_CLIENTS={"inventory-api":{"secret":"replace-with-32+-random-characters-xxxx","scope":"notifications.push"}}
#
# Rate limit for the token endpoint, per caller network address, counted on
# every attempt. Defaults shown; OPTIONAL to set.
SERVICE_TOKEN_RATE_LIMIT=20
SERVICE_TOKEN_RATE_WINDOW_MS=600000

# ─── Bootstrap admin (specs/004-auth-roles-permissions, AC-6.1) ─────────────
# Optional. When set, the account with this exact email is granted the
# `admin` role automatically the moment it first signs in (no manual DB
# edit) — matched against the verified OAuth email in
# `databaseHooks.user.create.after` (auth/src/auth/auth.config.ts), never
# against client-supplied input. Leave unset in most local/dev setups; every
# environment that needs an initial admin (including prod) MUST set this to
# a real wellD account before that account's first sign-in.
BOOTSTRAP_ADMIN_EMAIL=

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Test-only session-mint gate ─────────────────────────────────────────────
# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
# NEVER SET THIS IN PRODUCTION — it would allow anyone to mint a session for
# the seeded test user without any authentication, which is a complete auth
# bypass. Only set this in local dev and CI environments.
# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
# When set to "true" (and NODE_ENV is not "production"), the endpoint
# POST /test-auth/session is available for headless e2e tests (T9).
# Default: unset (disabled).
ENABLE_TEST_AUTH=true
