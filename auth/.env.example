# ─── Better Auth ─────────────────────────────────────────────────────────────
# Must be at least 32 random characters
BETTER_AUTH_SECRET=change-me-to-a-secure-random-string-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3001

# ─── Google OAuth ────────────────────────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── GitHub OAuth ────────────────────────────────────────────────────────────
# https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── RS256 JWT Key Pair ───────────────────────────────────────────────────────
# Generate with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Paste the PEM contents with literal \n for newlines:
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----"

# ─── JWT audience (ADR 20260713-jwt-audience-claim-enforcement, specs/20260713-notification-center T8) ──────────────
# Stamped as the standard `aud` claim on every JWT this service mints (the jwt
# plugin's `definePayload`, auth/src/auth/auth.config.ts) — NOT a secret, a
# suite-wide config identifier. Closes the cross-service JWT-replay gap now
# that notify-api is the suite's first real second JWKS resource server
# (a token minted for one resource server was, until now, structurally valid
# on any other — see ADR 20260713-jwt-audience-claim-enforcement).
# v1 is ONE shared value for every current resource server (estimai-api,
# notify-api) — not yet a per-service audience (ADR 20260713-jwt-audience-claim-enforcement "Consequences").
# CRITICAL: this value MUST be byte-for-byte identical to the `AUTH_AUDIENCE`
# each resource server's `jwtMiddleware` verifies against (T9) — a drifted
# value fails every request closed (401) in that environment. Treat it as a
# single constant documented alongside AUTH_ISSUER/AUTH_JWKS_URL wherever
# resource-server env vars are set (infra/README.md), not a bespoke
# per-service value.
AUTH_AUDIENCE=operai-suite

# ─── CORS ─────────────────────────────────────────────────────────────────────
# This list feeds BOTH the Hono CORS layer AND better-auth's `trustedOrigins`
# (which gates session-mutating calls like /auth/sign-out). Set it to the real
# UI origin(s) in each environment; no wildcards.
# SECURITY: do NOT set `BETTER_AUTH_TRUSTED_ORIGINS` — better-auth appends that
# env var to its trusted list at runtime, bypassing this validated allowlist.
# Leave it unset so ALLOWED_ORIGINS stays the single source of origin trust.
#
# specs/20260709-suite-shell (T17, ADR 20260607-sign-in-page-hosted-by-auth-service, ADR 20260709-suite-frontend-module-federation): the `shell` app is now the
# suite's single entry point and the ONLY origin that calls `getSession()` /
# `GET /auth/token` / `signOut()` in production — estimai-ui and refund-ui run
# as federated remotes INSIDE the shell's page and delegate every session call
# to the shared `shell/session` module (no independent auth guard of their
# own, see ADR 20260709-suite-frontend-module-federation). This means the PRODUCTION value of ALLOWED_ORIGINS only
# needs the shell's origin, not estimai-ui's or refund-ui's own origins:
#   ALLOWED_ORIGINS=https://operai.welld.io
# (https://operai.welld.io is the shell's production origin per
# infra/README.md — it was estimai-ui's standalone origin before the suite
# shell; the custom domain is reassigned to the shell project). REQUIRED
# PRODUCTION STEP: this repo cannot set the real ALLOWED_ORIGINS value for you —
# a human must set the deployed auth service's env var (see infra/README.md
# § Phase 3 / Variable reference) to the shell's real production origin before
# the shell can authenticate.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Post-login redirect fallback ────────────────────────────────────────────
# Absolute URL of the EstimAI home page. Used as the post-login destination
# when the sign-in `redirect` param is absent or fails origin validation
# (AC-1.3). Must be a URL whose origin is listed in ALLOWED_ORIGINS.
UI_HOME_URL=http://localhost:5173

# ─── notify-api internal email channel (specs/20260713-user-invitations, ADR 20260714-notify-api-email-channel-service-trust) ─
# Triggers the invite/resend email from the invitation admin API
# (src/lib/notify.ts → notify-api's internal, NON-user-JWT endpoint
# POST /system/emails). Two reused vars feed the email templates instead of
# new ones: BETTER_AUTH_URL above is the invite-link base
# (`${BETTER_AUTH_URL}/invite?id=...&token=...`) and UI_HOME_URL above is the
# post-accept redirect — both already declared, nothing new to add for those.
#
# NOTIFY_INTERNAL_URL: notify-api's base URL for the internal call.
# Local dev: notify-api's own dev port (see notify-api/.env.example PORT).
# Production (Railway): point this at notify-api's PRIVATE-networking
# hostname (`http://notify-api.railway.internal:<notify-api PORT>`), NOT its
# public *.operai.welld.io domain — plan.md Risk R2 / ADR 20260714-notify-api-email-channel-service-trust require this
# service-to-service call to stay off the public internet. See
# infra/README.md § Variable reference for the exact Railway reference syntax.
NOTIFY_INTERNAL_URL=http://localhost:8081

# ─── Sign-up gate (specs/20261105-signup-gate, ADR 20261105-access-only-by-invitation-waiting-list) ──────────────────────────────────────
# REQUIRED. Only accounts in these domains may join the waiting list or be
# invited. Comma-separated, lower-case, at least one; missing or malformed makes
# the service exit at startup. Deployment configuration, not an admin setting.
#
# Local/e2e value below includes the reserved test domain `operai.test` (specs/20260713-user-invitations's
# invitations e2e invites @operai.test addresses). PRODUCTION is `welld.ch,welld.it`:
# with NODE_ENV=production auth refuses to start when the list holds a reserved test
# domain (.test, .example, .invalid, .localhost), and env-doctor flags it before deploy.
ALLOWED_SIGNUP_DOMAINS=welld.ch,welld.it,operai.test

# ─── App-access eligibility check (specs/20260807-estimate-sharing, T1/T2, ───────
# ADR 20260807-third-party-app-access-decision-endpoint-forwarded-jwt) — has defaults, documented here for completeness (T13) ──────────
#
# `POST /authz/app-access-check` lets any signed-in end user (holding their
# own JWT, and gated on holding `(appId,"access")` themselves) ask whether
# ANOTHER user is eligible to be added as a collaborator — a decision
# endpoint, not a fact endpoint (ADR 20260807-third-party-app-access-decision-endpoint-forwarded-jwt): both "no such user" and "user
# exists but lacks app access" return the exact same `{eligible:false}` body,
# on the exact same code path, in the exact same minimum wall-clock time, so
# neither a bad guess nor a real-but-ineligible email can be told apart by a
# caller. FLOOR is that minimum time (ms) EVERY `eligible:false` response
# takes regardless of which cause produced it; the success path is not
# floored. RATE_LIMIT/_WINDOW_MS bound this directly-callable surface
# (sliding-window in-process, src/lib/rateLimiter.ts) — the first rate
# limiter in the suite. All three have defaults below and are OPTIONAL to set
# explicitly; override only to tune for a specific environment.
APP_ACCESS_CHECK_FLOOR_MS=150
APP_ACCESS_CHECK_RATE_LIMIT=40
APP_ACCESS_CHECK_RATE_WINDOW_MS=600000

# ─── Identity-resolution rate limit (specs/20260807-estimate-sharing, T27, ───────
# resolves T3 drift) — has defaults, documented here for completeness (T13) ─
#
# `POST /authz/users/identities` (T3, ADR 20260807-live-identity-resolution-by-id-fail-soft) resolves display identity
# (id → name/status) for the owner + collaborators of a shared estimate —
# id-keyed, caller-scoped, no email/name/query/prefix search, so it leaks no
# existence signal the caller doesn't already hold (unlike app-access-check
# above) and therefore needs NO response-time floor. It still needs a rate
# limit to bound the worst-case 100-id fan-out per call — reuses the SAME
# rateLimiter.ts module as APP_ACCESS_CHECK above (a second limiter instance,
# not a second implementation), keyed per caller `sub`. 120/10min sits far
# above real usage (roughly one batched call per estimates-list render).
# Both have defaults below and are OPTIONAL to set explicitly.
IDENTITIES_RATE_LIMIT=120
IDENTITIES_RATE_WINDOW_MS=600000

# ─── User directory rate limit (specs/20261006-hardware-inventory, T5; ADR 20261006-user-directory-endpoint-capability-gated) ─
# `GET /authz/users/directory` lists active users to holders of the inventory
# `asset:manage` permission (the assign picker). Gated by that permission, not
# floored; this bounds how often a holder can pull the roster. Keyed per caller
# `sub`, counted on every attempt. Defaults shown; OPTIONAL to set.
DIRECTORY_RATE_LIMIT=60
DIRECTORY_RATE_WINDOW_MS=600000

# ─── Service tokens (specs/20261006-hardware-inventory, T4; ADR 20261006-scoped-service-jwt-fourth-notify-caller) ────────────
# `POST /system/service-token` lets a SERVICE (refund-api, estimai-api,
# inventory-api) swap a per-client secret for a 5-minute RS256 JWT that notify-api
# accepts on its `/system` routes (specs/20261013-notify-service-credentials, ADR 20261013-all-notify-callers-scoped-credentials-shared-token-retired). SERVICE_AUDIENCE is
# REQUIRED (auth also mints its own credential with it, ADR 20261013-auth-mints-own-service-credential-in-process);
# SERVICE_CLIENTS is OPTIONAL: with no clients configured the endpoint
# authenticates nobody (every call is 401) and the service starts.
#
# SERVICE_AUDIENCE — the `aud` of those tokens. MUST differ from AUTH_AUDIENCE
# (startup exits otherwise) so a service token is never valid on a user route
# and a user JWT never valid on a system route. MUST equal notify-api's own
# SERVICE_AUDIENCE. REQUIRED.
#
# SERVICE_CLIENTS — JSON object keyed by client id; the key becomes the token
# `sub` as `system:<clientId>`. Each entry: `secret` (32-256 chars, generate with
# `openssl rand -base64 48`) and `scope` (space-delimited subset of
# `notifications.push` and `emails.send`). The client id `auth` is reserved:
# auth mints its own credential in process (ADR 20261013-auth-mints-own-service-credential-in-process). This holds SECRETS: in
# local dev keep a throwaway value; in real environments it lives in 1Password /
# the deploy environment only. The matching client side is each caller's
# SERVICE_CLIENT_ID + SERVICE_CLIENT_SECRET (same id and secret as the entry).
# To revoke a client, remove its entry (issued tokens expire within 5 minutes).
# Wrap the JSON in SINGLE quotes: direnv's dotenv parser rejects the unquoted
# value ("invalid line").
SERVICE_AUDIENCE=operai-service
# SERVICE_CLIENTS='{"inventory-api":{"secret":"replace-with-32+-random-characters-xxxx","scope":"notifications.push"},"estimai-api":{"secret":"replace-with-32+-random-characters-yyyy","scope":"notifications.push"},"refund-api":{"secret":"replace-with-32+-random-characters-zzzz","scope":"notifications.push emails.send"},"projects-api":{"secret":"replace-with-32+-random-characters-pppp","scope":"crm.companies.read crm.deals.read crm.contacts.read estimai.estimates.read notifications.push"},"crm-api":{"secret":"replace-with-32+-random-characters-cccc","scope":"notifications.push emails.send deal-link-notices.send activities.write projects.purchase-orders.read letterhead:render legal-entities:read"},"activities-api":{"secret":"replace-with-32+-random-characters-aaaa","scope":"notifications.push emails.send"},"letterhead-api":{"secret":"replace-with-32+-random-characters-llll","scope":"legal-entities:read"},"hours-api":{"secret":"replace-with-32+-random-characters-hhhh","scope":"meetings.hosts.read"}}'
#
# specs/20261117-legal-entities (T12, AC-3.2): the legal-entity registry's SERVICE read, `GET /system/legal-entities[/{entity}]`, takes
# the scope `legal-entities:read` (colon form, like `letterhead:render`; NOT `crm.companies.read`, which is about CRM customers).
# It is held by two clients: `crm-api` (added to the scopes it already has) and `letterhead-api` (a NEW client, exactly that scope:
# it reads the issuer's details itself and verifies `letterhead:render` without holding it). The example above shows both. Each
# secret must equal that service's own SERVICE_CLIENT_SECRET (letterhead-api: SERVICE_CLIENT_ID=letterhead-api). auth REFUSES to
# start with a scope it does not know, so in a shared environment edit this variable only AFTER the auth that knows
# `legal-entities:read` is deployed (infra/README.md § Legal entities rollout, step 2). Locally the scope is known from this branch on.
#
# One-off copy of the CRM's legal details (T9; infra/README.md § Legal entities rollout, step 3). NOT service configuration: the two
# connection strings below are set in the shell of the operator who runs `bun run scripts/import-crm-legal-details.ts`, never in this
# file, never as arguments, never in a deployed service's variables. `mise run legal-entities:import` sets both for the local compose
# databases (the CRM's `crm` and auth's `operai_auth` on :5435) and applies. The script opens the CRM session read only and refuses
# to read when the server does not honour that (exit 1, `crm_not_read_only`).
#   DATABASE_URL      the registry's database (auth's own: already set above for the service)
#   CRM_DATABASE_URL  the CRM's database, read only; must differ from DATABASE_URL (exit 64 otherwise)
#
# ─── Limits of POST /system/service-token and POST /system/users/contact ───
# (specs/20261111-push-notifications US-7, ADR 20261112-system-endpoints-limited-per-verified-service). The credential is verified FIRST, then one count:
# a valid credential is counted against its own calling service, an invalid one
# against its source address (one counter shared by both endpoints). All OPTIONAL;
# defaults shown. They share one window (>= 1000 ms), which is also the fixed
# Retry-After. A bad value stops the start.
SERVICE_TOKEN_SERVICE_LIMIT=300
USERS_CONTACT_SERVICE_LIMIT=600
SYSTEM_INVALID_CREDENTIAL_LIMIT=20
SYSTEM_RATE_WINDOW_MS=600000
# RETIRED: SERVICE_TOKEN_RATE_LIMIT and SERVICE_TOKEN_RATE_WINDOW_MS (one address
# bucket for the whole suite) are ignored with a startup warning; delete them
# from any environment (env-doctor flags them).

# ─── Legal-entity registry (specs/20261117-legal-entities, plan G4/G9, security review F3; T67) ──────────────────────────────────────
# Saves (`POST /legal-entities/{entity}/versions`) and restores of a legal entity are throttled per person (a sliding window in this process; the dry-run check
# `POST /legal-entities/{entity}/versions/check` has its own limit). The three are OPTIONAL; production uses the defaults
# (write 10, check 60, window 600000 ms) and env-doctor's test refuses a production template that raises the write limit above 10.
#
# LOCAL DEVELOPMENT AND THE E2E STACK ONLY: the write limit is raised below because the Playwright specs (shell/e2e/legal-entities*.spec.ts,
# protected-legal-details.spec.ts) save and restore far more than 10 times in ten minutes as one person. compose.yaml has no `auth`
# service (auth runs on the host, `bun run dev`, from this file), so this is where the e2e stack's limit lives. NEVER copy this value
# into a deployed environment.
LEGAL_ENTITY_WRITE_RATE_LIMIT=1000
# LEGAL_ENTITY_CHECK_RATE_LIMIT=60
# LEGAL_ENTITY_RATE_WINDOW_MS=600000

# The outside mailbox (AC-9.10): when set, every protected-change notice (legal name, VAT number, IBAN) is also emailed to this ONE
# address, for both entities, whoever saved. Must be a single email address or auth refuses to start (R21); unset = no outside
# recipient and nothing else changes. Notices are US-9 (plan G4, sent by auth since push 2). Locally leave it unset unless you read the
# mail of a catch-all test inbox; in production the owner sets it at release step 7 (infra/README.md § Legal entities rollout).
# LEGAL_ENTITY_NOTICE_EMAIL=

# ─── Bootstrap admin (specs/20260713-auth-roles-permissions, AC-6.1) ─────────────
# Optional. When set, the account with this exact email is granted the
# `admin` role automatically the moment it first signs in (no manual DB
# edit) — matched against the verified OAuth email in
# `databaseHooks.user.create.after` (auth/src/auth/auth.config.ts), never
# against client-supplied input. Leave unset in most local/dev setups; every
# environment that needs an initial admin (including prod) MUST set this to
# a real wellD account before that account's first sign-in.
BOOTSTRAP_ADMIN_EMAIL=

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ─── Test-only session-mint gate ─────────────────────────────────────────────
# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
# NEVER SET THIS IN PRODUCTION — it would allow anyone to mint a session for
# the seeded test user without any authentication, which is a complete auth
# bypass. Only set this in local dev and CI environments.
# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
# When set to "true" (and NODE_ENV is not "production"), the endpoint
# POST /test-auth/session is available for headless e2e tests (T9).
# Default: unset (disabled).
ENABLE_TEST_AUTH=true

# specs/20261103-projects-handoff scopes (ADR 20261104-projects-handoff-live-reads-between-crm-and-projects-over-service-credentials, ADR 20261104-estimai-api-first-system-route-estimate-man-days-for-a-service-credential) — the SERVICE_CLIENTS entries need:
#   "projects-api": "scope":"crm.companies.read crm.deals.read crm.contacts.read estimai.estimates.read notifications.push"
#   "crm-api":      "scope":"notifications.push emails.send projects.purchase-orders.read"

# specs/20261112-time-tracking scope (ADR 20261112-time-bookability-asked-of-owners-meeting-hosts-system-route) — the SERVICE_CLIENTS entry needs:
#   "hours-api":    "scope":"meetings.hosts.read"
# meetings-api verifies it on GET /system/meetings/hosts (sub system:hours-api). In
# production add the entry only AFTER this auth version is live: an unknown scope
# stops auth at startup (ADR 20261108-crm-pushes-deal-links-to-estimai).
