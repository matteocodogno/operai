# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/operai_auth

# ─── Better Auth ─────────────────────────────────────────────────────────────
# Must be at least 32 random characters
BETTER_AUTH_SECRET=change-me-to-a-secure-random-string-at-least-32-chars
BETTER_AUTH_URL=http://localhost:3001

# ─── Google OAuth ────────────────────────────────────────────────────────────
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── GitHub OAuth ────────────────────────────────────────────────────────────
# https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ─── RS256 JWT Key Pair ───────────────────────────────────────────────────────
# Generate with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Paste the PEM contents with literal \n for newlines:
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIB...\n-----END PUBLIC KEY-----"

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Post-login redirect fallback ────────────────────────────────────────────
# Absolute URL of the EstimAI home page. Used as the post-login destination
# when the sign-in `redirect` param is absent or fails origin validation
# (AC-1.3). Must be a URL whose origin is listed in ALLOWED_ORIGINS.
UI_HOME_URL=http://localhost:5173

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
