# Invalidate the cache when .envrc itself changes, or when it is older than a day
if [ .envrc -nt .env.cached ] || [ -n "$(find .env.cached -mtime +1 2>/dev/null)" ]; then
  rm -f .env.cached
fi

if [ ! -f .env.cached ]; then
  # Read one secret from 1Password; return non-zero (and warn) if op is locked or the value is empty
  op_read() {
    local out
    out="$(op read "$1" 2>/dev/null)"
    if [ $? -ne 0 ] || [ -z "$out" ]; then
      echo "direnv: could not read '$1' from 1Password — is it unlocked and signed in?" >&2
      return 1
    fi
    printf '%s' "$out"
  }

  # Fetch every secret first — if any read fails, abort before writing a partial/empty cache
  BETTER_AUTH_SECRET="$(op_read "op://Employee/Paperclip - BETTER_AUTH_SECRET/password")" || exit 1
  GOOGLE_CLIENT_ID="$(op_read "op://AIScream/OperAI - GOOGLE OAuth/Client ID")" || exit 1
  GOOGLE_CLIENT_SECRET="$(op_read "op://AIScream/OperAI - GOOGLE OAuth/Client Secret")" || exit 1
  GITHUB_CLIENT_ID="$(op_read "op://AIScream/OperAI - GITHUB OAuth/Client ID")" || exit 1
  GITHUB_CLIENT_SECRET="$(op_read "op://AIScream/OperAI - GITHUB OAuth/Client Secret")" || exit 1
  JWT_PRIVATE_KEY="$(op_read "op://AIScream/OperAI Private Key/private key")" || exit 1
  JWT_PUBLIC_KEY="$(op_read "op://AIScream/OperAI Private Key/public key")" || exit 1
  POSTGRES_USER="$(op_read "op://AIScream/OperAI DB/username")" || exit 1
  POSTGRES_PASSWORD="$(op_read "op://AIScream/OperAI DB/password")" || exit 1

  # All secrets resolved — write the cache atomically (temp + mv) so it is never half-written
  {
    echo "export BETTER_AUTH_SECRET=$BETTER_AUTH_SECRET"
    echo "export GOOGLE_CLIENT_ID=$GOOGLE_CLIENT_ID"
    echo "export GOOGLE_CLIENT_SECRET=$GOOGLE_CLIENT_SECRET"
    echo "export GITHUB_CLIENT_ID=$GITHUB_CLIENT_ID"
    echo "export GITHUB_CLIENT_SECRET=$GITHUB_CLIENT_SECRET"
    echo "export JWT_PRIVATE_KEY=\"$JWT_PRIVATE_KEY\""
    echo "export JWT_PUBLIC_KEY=\"$JWT_PUBLIC_KEY\""
    echo "export POSTGRES_USER=$POSTGRES_USER"
    echo "export POSTGRES_PASSWORD=$POSTGRES_PASSWORD"
  } > .env.cached.tmp && mv .env.cached.tmp .env.cached
fi
source .env.cached
