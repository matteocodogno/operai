# estimai-ui environment variables
# Copy to .env.local and fill in values for local development.
# Never commit .env.local or any file with real secrets.

# URL of the Operai auth service.
# Local default: the auth service started via `bun run dev` in the auth/ directory.
# Production: set to the deployed auth service URL (e.g. https://auth.operai.io).
VITE_AUTH_URL=http://localhost:3001
