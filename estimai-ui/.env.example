# estimai-ui environment variables
# Copy to .env.local and fill in values for local development.
# Never commit .env.local or any file with real secrets.

# URL of the Operai auth service.
# Local default: the auth service started via `bun run dev` in the auth/ directory.
# Production: set to the deployed auth service URL (e.g. https://auth.operai.io).
VITE_AUTH_URL=http://localhost:3001

# URL of the estimai-api backend service.
# Local default: the estimai-api service started via `bun run dev` in the estimai-api/ directory.
# Production: set to the deployed API URL (e.g. https://api.estimai.operai.io).
VITE_API_URL=http://localhost:8080

# Runtime remoteEntry.js URL for the shell host (T13, specs/003-suite-shell,
# mirrors shell/.env.example's ESTIMAI_REMOTE_URL/REFUND_REMOTE_URL pattern).
# Read in vite.config.ts via `process.env`, NOT `import.meta.env` — it
# configures Vite itself (Node-side), not client code, so it is a plain env
# var, not VITE_-prefixed. estimai-ui consumes the shell as a remote to
# import the shared `shell/session` module (src/lib/api.ts, authClient.ts).
# Dev-only default is baked into vite.config.ts; set this to point at
# wherever the shell is actually being served.
# SHELL_REMOTE_URL=http://localhost:5173/remoteEntry.js
