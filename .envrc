export OP_SERVICE_ACCOUNT_TOKEN="$(security find-generic-password -a "$USER" -s op-sa-operai-local -w)"
if  [ $(find .env.cached -mtime +1) ]; then
  rm -f .env.cached
fi

if [ ! -f .env.cached ]; then
    echo "export POSTGRES_USER=$(op read "op://OperAILocal/OperAI DB/username")" >> .env.cached
    echo "export POSTGRES_PASSWORD=$(op read "op://OperAILocal/OperAI DB/password")" >> .env.cached
    echo "export RAILWAY_PROJECT_ID=$(op read "op://OperAILocal/OperAI Railway/project id")" >> .env.cached
fi
source .env.cached
