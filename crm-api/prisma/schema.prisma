generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Data model of specs/20261101-crm (plan.md § Data model). Money is integer minor
// units (ADR 20260720-mileage-rate-money-precision-integer-micros posture); calendar dates are @db.Date. People are opaque
// `auth` user ids, their names resolved live (ADR 20260807-live-identity-resolution-by-id-fail-soft, decisions D-15).
//
// Raw SQL in the initial migration, the ENFORCEMENT and not a duplicate:
//   - company_name_lower_key  UNIQUE (lower(name)), archived companies included (D-11)
//   - contact_email_lower_idx  lookup index for the contacts search
//   - CHECKs                   amount ≥ 0, country is two upper-case letters,
//                              closedAt set iff the stage is closed, task fields
//                              only on tasks

enum Entity {
  welld_ch
  welld_it
}

enum CompanyStatus {
  prospect
  customer
  former
}

/// Where a company or a lead came from (specs/20261101-crm US-7).
enum LeadSource {
  inbound
  outbound
  event
  referral
  other
}

enum DealStage {
  lead
  qualified
  proposal
  negotiation
  won
  lost
}

enum Currency {
  CHF
  EUR
}

model Company {
  id          String        @id @default(cuid())
  name        String
  status      CompanyStatus
  entity      Entity
  website     String?
  industry    String?
  city        String?
  /// ISO 3166-1 alpha-2, upper case.
  country     String?
  /// Printed in the offer's client block when set (specs/20261102-crm-offer-document AC-5.1).
  legalName   String?
  street      String?
  postalCode  String?
  notes       String?
  /// How the relationship started (US-7); `sourceDetail` names the event, the referrer or what else.
  source       LeadSource?
  sourceDetail String?
  ownerUserId String
  archivedAt  DateTime?
  /// Optimistic-concurrency counter (ADR 20260807-optimistic-concurrency-version-if-match-cas-amends-0004 posture, D-7).
  version     Int           @default(1)
  createdBy   String
  updatedBy   String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  contacts   Contact[]
  deals      Deal[]

  @@index([status])
  @@index([ownerUserId])
  @@map("company")
}

model Contact {
  id         String    @id @default(cuid())
  companyId  String?
  company    Company?  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  firstName  String
  lastName   String
  email      String?
  phone      String?
  jobTitle   String?
  notes      String?
  archivedAt DateTime?
  version    Int       @default(1)
  createdBy  String
  updatedBy  String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt


  @@index([companyId])
  @@map("contact")
}

model Deal {
  id                String    @id @default(cuid())
  companyId         String
  company           Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  title             String
  stage             DealStage @default(lead)
  /// Null until it is known: a lead often has no figure yet (specs/20261101-crm AC-3.2, 2026-11-04).
  amountCents       BigInt?
  currency          Currency
  entity            Entity
  expectedCloseDate DateTime? @db.Date
  ownerUserId       String
  lostReason        String?
  /// Set when the deal moves to won/lost, cleared when it is reopened.
  closedAt          DateTime?
  notes             String?
  /// Where this lead came from (US-7); `sourceDetail` names the event, the referrer or what else.
  source            LeadSource?
  sourceDetail      String?
  version           Int       @default(1)
  createdBy         String
  updatedBy         String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  estimate    DealEstimate?
  offers      DealOffer[]
  attachments DealAttachment[]
  offerDraft  OfferDraft?

  @@index([stage])
  @@index([companyId])
  @@index([closedAt])
  @@map("deal")
}

enum EstimateState {
  requested
  ready
}

/// The deal's link to one EstimAI estimate (specs/20261101-crm-sales-flow US-3). `estimateId` is an
/// estimai-api id, never dereferenced by a foreign key: that service owns it.
model DealEstimate {
  dealId          String        @id
  deal            Deal          @relation(fields: [dealId], references: [id], onDelete: Cascade)
  estimateId      String
  estimateName    String
  technicalUserId String
  state           EstimateState @default(requested)
  requestedBy     String
  requestedAt     DateTime      @default(now())
  readyBy         String?
  readyAt         DateTime?
  /// The task created for the technical contact; completed when the estimate is ready.
  taskId          String?
  /// The EstimAI version of the last close/reopen notice applied (AC-3.3): an
  /// older notice arriving late is ignored.
  estimaiVersion  Int?
  /// An admin's override of the Qualified → Proposal gate (AC-3.7).
  overrideBy      String?
  overrideReason  String?
  overrideAt      DateTime?

  @@index([technicalUserId])
  @@map("deal_estimate")
}

enum OfferLanguage {
  en
  it
}

/// A generated offer PDF (specs/20261101-crm-sales-flow US-4). Immutable once written: only the
/// soft-delete pair ever changes; a deleted number is never reused.
model DealOffer {
  id           String        @id @default(cuid())
  dealId       String
  deal         Deal          @relation(fields: [dealId], references: [id], onDelete: Restrict)
  number       Int
  language     OfferLanguage
  priceCents   BigInt
  currency     Currency
  validityDays Int
  terms        String?
  /// The offer number (`NNNN/YYYY`, specs/20261102-crm-offer-document D-5): null for specs/20261101-crm-sales-flow offers.
  /// A deal's sequenced offers all share the first one's year and number.
  sequenceYear Int?
  sequenceNo   Int?
  /// Everything printed: letterhead, client, scope figures, texts.
  snapshot     Json
  objectKey    String
  sizeBytes    Int
  /// The version of the entity's letterhead the layout service drew the pages with (specs/20261116-letterhead-service AC-10.2).
  /// Null for an offer made by crm-api's own renderer: every offer before the switch, and any made while the switch is off.
  letterheadVersion Int?
  createdBy    String
  createdAt    DateTime      @default(now())
  /// specs/20261102-crm-offer-document US-7: an offer is edited in place until it is marked sent; after that a change
  /// is a new revision. `version` is the If-Match precondition of an edit (ADR 20260807-optimistic-concurrency-version-if-match-cas-amends-0004 posture).
  sentAt       DateTime?
  sentBy       String?
  version      Int           @default(1)
  updatedBy    String?
  updatedAt    DateTime?
  deletedBy    String?
  deletedAt    DateTime?

  /// The wizard drafts that edit or revise this offer (ADR 20261115-offer-draft-server-held-generated-from-stored-state); no column here.
  drafts OfferDraft[]

  @@unique([dealId, number])
  @@map("deal_offer")
}

enum AttachmentStatus {
  pending
  stored
}

/// A file uploaded to a deal (specs/20261101-crm-sales-flow AC-4.3). Two-phase like inventory's
/// invoice files: `pending` until crm-api has seen the object, then `stored`.
model DealAttachment {
  id          String           @id @default(cuid())
  dealId      String
  deal        Deal             @relation(fields: [dealId], references: [id], onDelete: Restrict)
  fileName    String
  contentType String
  sizeBytes   Int
  objectKey   String           @unique
  status      AttachmentStatus @default(pending)
  uploadedBy  String
  createdAt   DateTime         @default(now())
  deletedBy   String?
  deletedAt   DateTime?

  @@index([dealId])
  @@map("deal_attachment")
}

/// Letterhead and default offer terms of one wellD entity (specs/20261101-crm-sales-flow O2).
model EntityProfile {
  entity       Entity   @id
  /// RETIRED (specs/20261117-legal-entities, plan step 6 drops these four columns): the issuer's legal details are kept in
  /// the registry in auth. Nothing reads or writes them but the one-time copy script; a row created by PUT takes the defaults.
  legalName    String   @default("")
  addressLines String[] @default([])
  vatNumber    String?
  iban         String?
  offerTermsEn String?
  offerTermsIt String?
  /// Printed beside the date of an offer (specs/20261102-crm-offer-document AC-1.2); "Lugano" when null.
  placeOfIssue String?
  /// Key of the letterhead PDF in the CRM bucket (specs/20261102-crm-offer-document AC-2.1).
  letterheadKey String?
  letterheadBy  String?
  letterheadAt  DateTime?
  updatedBy    String
  updatedAt    DateTime @updatedAt

  @@map("entity_profile")
}

/// A named starting point for an offer, owned by one entity (specs/20261102-crm-offer-document AC-2.2).
/// Raw SQL in the migration, the ENFORCEMENT: offer_template_entity_name_active_key
/// UNIQUE (entity, lower(name)) WHERE "archivedAt" IS NULL.
/// `sections`: the 018 dialog's contract text (specs/20261102-crm-offer-document); `wizard`: one self-describing
/// text the offer wizard reads (specs/20261115-crm-offer-wizard, ADR 20261115-offer-template-format-supersession-per-entity-language).
enum OfferTemplateFormat {
  sections
  wizard
}

/// A template of an entity and language. Raw SQL in the offer_wizard migration, the enforcement and not a
/// duplicate: CHECK `offer_template_format_content` (a `sections` row has every legacy column and no
/// `source`; a `wizard` row has a `source` of at most 150 000 characters) and the partial unique index
/// `offer_template_entity_seed_key` on (entity, seedKey) where seedKey is not null. The legacy columns
/// are optional here ONLY because a wizard row has none: read them through `legacyContent(row)`.
model OfferTemplate {
  id              String              @id @default(cuid())
  entity          Entity
  name            String
  language        OfferLanguage
  format          OfferTemplateFormat @default(sections)
  salutation      String?
  opening         String?
  /// [{ heading, body, costs }]
  sections        Json?
  /// [{ description, kind, amount, quantity }] — see src/offers/contract.ts
  costLines       Json?
  /// { position, unit }
  costColumns     Json?
  showTotal       Boolean             @default(false)
  acceptanceLabel String?
  annex           Boolean             @default(false)
  /// Wizard only: one line of at most 160 characters shown on the template card.
  description     String?
  /// Wizard only: up to six short labels naming what the template covers.
  uses            String[]            @default([])
  /// Wizard only: the template text (the extended offer markup), at most 150 000 characters.
  source          String?
  /// Set on a seeded template, e.g. `welld-ch-it-v1:T1`; a seed is created once per key, archived rows counting.
  seedKey         String?
  /// If-Match concurrency counter (ADR 20260807-optimistic-concurrency-version-if-match-cas-amends-0004 posture).
  version         Int                 @default(1)
  archivedAt      DateTime?
  createdBy       String
  createdAt       DateTime            @default(now())
  updatedBy       String
  updatedAt       DateTime            @updatedAt

  drafts OfferDraft[]

  @@index([entity])
  @@map("offer_template")
}

enum OfferDraftTarget {
  new
  edit
  revision
}

/// The wizard's in-progress offer of a deal: at most one per deal, held by the server (ADR
/// 20261115-offer-draft-server-held-generated-from-stored-state). `answers` is the engine's WizardAnswers (≤ 512 KiB,
/// checked by the route). Raw SQL in the migration: CHECK `offer_draft_target` — a `new` draft has no target
/// offer, an `edit` or `revision` draft has the offer and the version it was opened at.
model OfferDraft {
  dealId             String           @id
  deal               Deal             @relation(fields: [dealId], references: [id], onDelete: Cascade)
  templateId         String
  template           OfferTemplate    @relation(fields: [templateId], references: [id], onDelete: Restrict)
  /// The template version the answers match; the template moving on is a notice, not an error.
  templateVersion    Int
  targetKind         OfferDraftTarget @default(new)
  targetOfferId      String?
  targetOffer        DealOffer?       @relation(fields: [targetOfferId], references: [id], onDelete: Restrict)
  targetOfferVersion Int?
  answers            Json
  /// If-Match concurrency counter.
  version            Int              @default(1)
  createdBy          String
  createdAt          DateTime         @default(now())
  updatedBy          String
  updatedAt          DateTime         @updatedAt

  @@index([templateId])
  @@map("offer_draft")
}

/// The last offer number taken per entity and year (specs/20261102-crm-offer-document D-5). Taken with
/// INSERT … ON CONFLICT DO UPDATE inside the generation transaction.
model OfferSequence {
  entity Entity
  year   Int
  last   Int

  @@id([entity, year])
  @@map("offer_sequence")
}
