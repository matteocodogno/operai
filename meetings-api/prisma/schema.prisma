generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Data model of specs/20261104-meetings (plan.md § Data model). People are opaque
// `auth` user ids, their names resolved live (ADR 20260807-live-identity-resolution-by-id-fail-soft). Time-based states
// (interrupted, audio expired, frozen, stale summary, stuck answer) are DERIVED
// on read and never stored (ADR 20260714-invitation-lifecycle-derived-expiry-state/0062).
//
// Raw SQL in the initial migration, the ENFORCEMENT and not a duplicate:
//   - CHECK meeting_host_all_or_none        hostApp/hostEntityType/hostEntityId all or none
//   - CHECK meeting_host_visible_needs_host hostVisible implies a host
//   - CHECK meeting_consent_all_or_none     consent* all or none
//   - CHECK meeting_no_consent_on_text      a `text` meeting carries no consent (G1)
//   - CHECK meeting_participant_kind_xor    exactly one of userId / externalName
//   - CHECK meeting_participant_external_org  an organisation only on an external
//   - CHECK summary_template_owner_scope    ownerUserId iff scope = personal
//   - CHECKs on text lengths (title, names, question)
//   - UNIQUE recording_session_live_key     one live session per meeting (partial)
//   - UNIQUE summary_template_personal_name_key / _shared_name_key (partial, lower(name))
//   - Tier-1 append-only trigger on meeting_deletion (ADR 20260716-immutable-financial-audit-trail-refund mechanism)

enum MeetingFormat {
  in_person
  online
}

enum MeetingLanguage {
  en
  it
}

enum MeetingSource {
  recorded
  uploaded
  text
}

// `interrupted` is DERIVED, never stored.
enum MeetingStatus {
  draft
  recording
  processing
  ready
  failed
}

enum ProcessingStage {
  preparing
  transcribing
}

enum SummaryStatus {
  generating
  ready
  failed
}

enum TurnStatus {
  pending
  answered
  failed
}

enum TemplateScope {
  personal
  shared
}

enum JobKind {
  prepare_audio
  transcribe
  summarize
  deliver_host_notice
  deliver_hours_notice
}

enum JobState {
  queued
  running
  done
  failed
}

enum AttachmentKind {
  file
  link
}

// A file is `pending` from its upload mint until the bucket object is confirmed; a link is `stored` at once.
enum AttachmentStatus {
  pending
  stored
}

enum NoticeEvent {
  linked
  changed
  unlinked
  deleted
}

enum NoticePolicy {
  manual
  until_delivered
}

enum NoticeState {
  pending
  delivered
  failed
}

// specs/20261112-meeting-hours: what a hours notice announces (the meeting's facts as they are when it is sent,
// or that the meeting is gone) and whether it still waits for delivery. A delivered row is deleted.
enum HoursNoticeKind {
  state
  deleted
}

enum HoursNoticeState {
  pending
  failed
}

model Meeting {
  id            String           @id @default(cuid())
  title         String
  format        MeetingFormat
  startsAt      DateTime
  language      MeetingLanguage
  source        MeetingSource
  status        MeetingStatus    @default(draft)
  stage         ProcessingStage?
  // closed set in code: audio_unreadable | provider_unavailable | provider_rejected | too_long
  failureCode   String?
  noSpeech      Boolean          @default(false)
  creatorUserId String

  // all or none (CHECK)
  hostApp        String?
  hostEntityType String?
  hostEntityId   String?
  hostVisible    Boolean @default(false)
  hostNoticeSeq  Int     @default(0)
  // Version of the hours facts (startsAt, durationMs, Operai participants) last announced to hours-api
  // (specs/20261112-meeting-hours). Bumped, in the transaction that changes one of them, by the writer of the hours notice.
  hoursSeq       Int     @default(0)

  // all or none (CHECK); none on a `text` meeting
  consentUserId        String?
  consentAt            DateTime?
  consentNoticeVersion String?

  durationMs     Int?
  audioKey       String?
  audioBytes     Int?
  // drives "kept until" = audioCreatedAt + 29 d (D-9)
  audioCreatedAt DateTime?
  audioDeletedAt DateTime?

  // AC-12.2 recipient
  processingRequestedBy  String?
  // non-null => language locked (AC-1.8)
  processingStartedAt    DateTime?
  // left `processing`
  processedAt            DateTime?
  transcriptVersion      Int       @default(0)
  // where each transcript PART starts (ADR 20261105-meetings-transcript-parts-speaker-labels-per-part): [0] for one part, [0, t2, ...] for a long recording;
  // empty for a `text` meeting and for `noSpeech`. Written with the segments, replaced on a retry.
  transcriptPartStartsMs Int[]     @default([])
  // where each part ENDS (specs/20261104-meetings plan H-5): paired with the starts, which now overlap. Empty exactly when they are.
  transcriptPartEndsMs   Int[]     @default([])
  // The agenda's If-Match version: bumped by every change of its points (add, edit, remove, reorder), NOT by a
  // covered mark, so two people ticking different points never conflict.
  agendaVersion          Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions      RecordingSession[]
  chunks        RecordingChunk[]
  upload        MeetingUpload?
  participants  MeetingParticipant[]
  segments      TranscriptSegment[]
  gaps          TranscriptGap[]
  speakerLabels SpeakerLabel[]
  summaries     Summary[]
  agenda        AgendaPoint[]
  notes         MeetingNote[]
  attachments   MeetingAttachment[]
  folderEntries MeetingFolderEntry[]
  turns         ConversationTurn[]
  jobs          MeetingJob[]

  @@index([creatorUserId, startsAt(sort: Desc)])
  @@index([hostApp, hostEntityType, hostEntityId])
  @@map("meeting")
}

// One live (endedAt IS NULL) session per meeting: partial UNIQUE in raw SQL.
model RecordingSession {
  id          String    @id @default(cuid())
  meetingId   String
  meeting     Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  startedAt   DateTime  @default(now())
  lastChunkAt DateTime?
  lastBeatAt  DateTime  @default(now())
  paused      Boolean   @default(false)
  // G3: the max reported by heartbeat / chunk confirm
  capturedMs  Int?
  endedAt     DateTime?
  endReason   String?

  chunks RecordingChunk[]

  @@index([meetingId])
  @@map("recording_session")
}

model RecordingChunk {
  meetingId  String
  meeting    Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  seq        Int
  sessionId  String
  session    RecordingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  objectKey  String
  sizeBytes  Int
  durationMs Int
  storedAt   DateTime?

  @@id([meetingId, seq])
  @@index([sessionId])
  @@map("recording_chunk")
}

model MeetingUpload {
  meetingId   String   @id
  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  objectKey   String
  contentType String
  // <= 500 MiB fits Int
  sizeBytes   Int
  mintedAt    DateTime @default(now())

  @@map("meeting_upload")
}

model MeetingParticipant {
  id                   String   @id @default(cuid())
  meetingId            String
  meeting              Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId               String?
  externalName         String?
  externalOrganisation String?
  addedBy              String
  createdAt            DateTime @default(now())

  speakerLabels SpeakerLabel[]

  @@unique([meetingId, userId])
  @@index([userId])
  @@map("meeting_participant")
}

// Text meetings: startMs / endMs / speakerKey are NULL (passages).
model TranscriptSegment {
  id         String  @id @default(cuid())
  meetingId  String
  meeting    Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  ordinal    Int
  startMs    Int?
  endMs      Int?
  speakerKey String?
  text       String
  edited     Boolean @default(false)
  version    Int     @default(1)
  // 1-based transcript part the segment comes from (H-5); null for a `text` meeting and for rows older than the column
  part       Int?

  @@unique([meetingId, ordinal])
  @@map("transcript_segment")
}

// A stretch of the recording that may be missing from the transcript (AC-6.12): meeting time, merged. Written with the
// segments (replaced, never appended), deleted with the meeting; AC-6.3 does not touch it. The creator can mark one
// "no speech here" after listening (A10): it is then ignored everywhere, and replaced with the gaps on retranscription.
model TranscriptGap {
  id          String    @id @default(cuid())
  meetingId   String
  meeting     Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  startMs     Int
  endMs       Int
  dismissedAt DateTime?
  dismissedBy String?

  @@index([meetingId, startMs])
  @@map("transcript_gap")
}

model SpeakerLabel {
  meetingId     String
  meeting       Meeting             @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  speakerKey    String
  participantId String?
  participant   MeetingParticipant? @relation(fields: [participantId], references: [id], onDelete: SetNull)
  customLabel   String?
  // a separated label that inherits an unnamed "Speaker n" keeps reading n until renamed (AC-6.16, H-0); a rename clears it
  defaultIndex  Int?

  @@id([meetingId, speakerKey])
  @@map("speaker_label")
}

model Summary {
  id                String          @id @default(cuid())
  meetingId         String
  meeting           Meeting         @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  authorUserId      String
  // snapshot: { source, templateId, name, sections[{heading, instruction}], generalInstructions }
  template          Json
  language          MeetingLanguage
  status            SummaryStatus
  attemptId         String
  failureCode       String?
  // [{ heading, body, notDiscussed }]
  sections          Json?
  transcriptVersion Int
  // the transcript's gaps when it was made (AC-7.13): [{ startMs, endMs }], a self-describing snapshot
  transcriptGaps    Json            @default("[]")
  edited            Boolean         @default(false)
  version           Int             @default(1)
  createdAt         DateTime        @default(now())
  readyAt           DateTime?

  @@index([meetingId, createdAt])
  @@map("summary")
}

// The meeting's agenda: ordered points (title 1..80, note <= 500, CHECKs in SQL), at most 30 per meeting (code).
// Edited by the creator and by Operai participants holding meetings:access; deleted with the meeting.
// `covered` is for people only: it never reaches a model.
model AgendaPoint {
  id        String   @id @default(cuid())
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  position  Int
  title     String
  note      String?
  covered   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([meetingId, position])
  @@map("agenda_point")
}

// A file or a link attached to a meeting (an agenda, slides, notes, a document) by its creator or an Operai
// participant. A FILE lives in the meetings bucket under `meetings/<id>/attachments/<uuid>` and is removed by the
// bucket's 29-day lifecycle rule like the audio: "expired" is derived on read from `storedAt`, never written. A LINK
// is a reference only: the service never fetches it. Raw SQL CHECKs enforce the per-kind columns and the lengths.
model MeetingAttachment {
  id            String           @id @default(cuid())
  meetingId     String
  meeting       Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  kind          AttachmentKind
  status        AttachmentStatus
  // file only
  name          String?
  contentType   String?
  sizeBytes     Int?
  objectKey     String?          @unique
  storedAt      DateTime?
  // link only
  url           String?
  label         String?
  addedByUserId String
  createdAt     DateTime         @default(now())

  @@index([meetingId, createdAt])
  @@map("meeting_attachment")
}

// One person's private notes on one meeting: read and written only by that person (never the creator of the
// meeting, never a model, never a log). At most one row per (meeting, person); deleted with the meeting.
model MeetingNote {
  meetingId String
  meeting   Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId    String
  // A rich-text document (TipTap JSON: a `doc` node). Data, never HTML: only the editor's schema renders it.
  content   Json
  // If-Match of the autosave: two tabs of the same person never overwrite each other silently.
  version   Int      @default(1)
  updatedAt DateTime @updatedAt

  @@id([meetingId, userId])
  @@map("meeting_note")
}

// One person's own folder for organising the meetings they see (ADR 20261113-personal-meeting-folders). Private to its owner: no other person, role
// or service reads it. A name is unique per owner ignoring case (partial index in raw SQL).
model MeetingFolder {
  id          String               @id @default(cuid())
  ownerUserId String
  name        String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  entries     MeetingFolderEntry[]

  @@index([ownerUserId])
  @@map("meeting_folder")
}

// Where ONE person keeps ONE meeting: at most one folder per (meeting, person). Deleted with the meeting or the folder.
model MeetingFolderEntry {
  meetingId String
  meeting   Meeting       @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId    String
  folderId  String
  folder    MeetingFolder @relation(fields: [folderId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@id([meetingId, userId])
  @@index([userId, folderId])
  @@map("meeting_folder_entry")
}

// Built-in templates live in code (src/templates/builtin.ts), never here.
model SummaryTemplate {
  id                  String        @id @default(cuid())
  scope               TemplateScope
  // personal only (CHECK)
  ownerUserId         String?
  name                String
  // 1..15 x { heading 1..80, instruction <= 500 }
  sections            Json
  generalInstructions String?
  createdBy           String
  updatedBy           String
  // If-Match on PATCH (G8)
  version             Int           @default(1)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@map("summary_template")
}

model ConversationTurn {
  id                String     @id @default(cuid())
  meetingId         String
  meeting           Meeting    @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId            String
  question          String
  status            TurnStatus
  // { text, citations: segmentId[], notInMeeting }
  answer            Json?
  failureCode       String?
  transcriptVersion Int
  createdAt         DateTime   @default(now())
  answeredAt        DateTime?

  @@index([meetingId, userId, createdAt])
  @@map("conversation_turn")
}

// The hours outbox (specs/20261112-meeting-hours, ADR 20261124-meeting-hours-facts-pushed-by-their-owner-as-a-versioned-state-built-at-send-time-through-an-until-delivered-outbox-and-applied-by-hours-api-only-when-not-older).
// meetingId has NO foreign key: a `deleted` notice outlives its meeting. The row holds NO personal data and no
// content: the facts it announces are read when it is sent. A delivered row is deleted; a `failed` one is kept
// with its closed code for the operator.
model HoursNotice {
  id            String           @id @default(cuid())
  meetingId     String
  seq           Int
  kind          HoursNoticeKind
  state         HoursNoticeState @default(pending)
  attempts      Int              @default(0)
  lastErrorCode String?
  createdAt     DateTime         @default(now())

  @@index([meetingId])
  @@map("hours_notice")
}

// Content-free, append-only rate-limit ledger (AC-13.4); pruned per user on insert.
model AiRequest {
  id     String   @id @default(cuid())
  userId String
  kind   String
  at     DateTime @default(now())

  @@index([userId, at])
  @@map("ai_request")
}

model MeetingJob {
  id            String    @id @default(cuid())
  kind          JobKind
  meetingId     String?
  meeting       Meeting?  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  summaryId     String?
  noticeId      String?
  attemptId     String?
  state         JobState  @default(queued)
  attempts      Int       @default(0)
  maxAttempts   Int
  runAfter      DateTime  @default(now())
  leaseUntil    DateTime?
  lastErrorCode String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([state, runAfter])
  @@map("meeting_job")
}

// The host-notice outbox. meetingId has NO foreign key: the row outlives the
// meeting's deletion (AC-14.6), and carries no title for `unlinked` / `deleted`.
model HostNotice {
  id            String       @id @default(uuid())
  hostApp       String
  entityType    String
  entityId      String
  meetingId     String
  seq           Int
  event         NoticeEvent
  title         String?
  startsAt      DateTime?
  creatorUserId String
  policy        NoticePolicy
  state         NoticeState  @default(pending)
  attempts      Int          @default(0)
  lastErrorCode String?
  createdAt     DateTime     @default(now())
  deliveredAt   DateTime?

  @@index([meetingId])
  @@map("host_notice")
}

// Content-free (no title column, AC-4.6). Tier-1 append-only: a BEFORE
// UPDATE/DELETE trigger (ADR 20260716-immutable-financial-audit-trail-refund mechanism); tests reset it with TRUNCATE,
// which a row trigger does not block (cf. ADR 20260804-two-tier-audit-assurance-auth-audit-log-application-level).
model MeetingDeletion {
  id              String   @id @default(cuid())
  meetingId       String
  deletedByUserId String
  // creator | erase
  via             String
  deletedAt       DateTime @default(now())

  @@map("meeting_deletion")
}
