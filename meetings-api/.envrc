export OP_SERVICE_ACCOUNT_TOKEN="$(security find-generic-password -a "$USER" -s op-sa-operai-local -w)"
source_up
dotenv_if_exists .env

# export MEETINGS_AI_PROVIDER=real          # 'fake' for normal dev with no Google calls
export MEETINGS_AI_PROVIDER=fake
export MEETINGS_SPEECH_LOCATION=eu
export MEETINGS_VERTEX_LOCATION=eu
export MEETINGS_VERTEX_MODEL_ID=claude-sonnet-5-5
export MEETINGS_GCP_PROJECT_ID="aiscream"
export MEETINGS_GCS_TRANSIENT_BUCKET="aiscream-meetings-transient"
export MEETINGS_GCP_SERVICE_ACCOUNT_KEY="$(op read 'op://OperAILocal/OperAI - Meetings GCP SA/key-base64')"

# audio bucket in dev = MinIO
export MEETINGS_S3_ENDPOINT=http://localhost:9000 MEETINGS_S3_REGION=eu-central-1 MEETINGS_S3_BUCKET=meetings
export MEETINGS_S3_ACCESS_KEY_ID=minioadmin MEETINGS_S3_SECRET_ACCESS_KEY=minioadmin MEETINGS_S3_EU_ENDPOINT_HOSTS=localhost


export DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5435/inventory"