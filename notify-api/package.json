{
  "name": "@operai/notify-api",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "db:migrate": "node node_modules/prisma/build/index.js migrate dev",
    "db:deploy": "node node_modules/prisma/build/index.js migrate deploy",
    "db:generate": "node node_modules/prisma/build/index.js generate",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@hono/zod-openapi": "^0.18.3",
    "@prisma/adapter-pg": "7.7.0",
    "@prisma/client": "7",
    "@scalar/hono-api-reference": "^0.5.165",
    "dotenv": "17.4.2",
    "effect": "^3.12.4",
    "hono": "^4.6.16",
    "jose": "6.2.3",
    "resend": "6.17.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "prisma": "7.7.0",
    "typescript": "^5.7.3"
  },
  "trustedDependencies": [
    "@prisma/engines",
    "prisma"
  ]
}
