# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/estimai

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no wildcards).
# Must include the UI origin(s) for each environment.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Auth (JWT resource-server verification) ─────────────────────────────────
# auth service JWKS endpoint — used by jwtMiddleware to verify RS256 tokens.
# Both values are required; the service will refuse to start if either is missing.
#
# IMPORTANT: use /auth/jwks (better-auth's built-in JWKS endpoint) NOT
# /.well-known/jwks.json — the latter serves the env-var key (kid:
# operai-auth-rs256-v1) which is a DIFFERENT key from the one better-auth's
# jwt plugin uses (stored in the jwks table, dynamic kid). The /auth/token
# endpoint signs with the DB keypair, so estimai-api must verify against
# /auth/jwks.
AUTH_JWKS_URL=http://localhost:3001/auth/jwks
AUTH_ISSUER=http://localhost:3001

# ─── Size guard ───────────────────────────────────────────────────────────────
# Added by T5 — MAX_ESTIMATE_BYTES goes here. Default: 1048576 (1 MiB).
# MAX_ESTIMATE_BYTES=1048576

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
