# ═══════════════════════════════════════════════════════════════════════════
# estimai-api environment variables
#
# DATA RESIDENCY — MANDATORY constraints (spec 001, CLAUDE.md):
#   1. EU region: this service MUST be deployed to an EU region only.
#      Production target: Railway EU (europe-west4) — see railway.json.
#      No estimate data may be stored outside the EU.
#   2. No body logging: request/response bodies (including estimate `content`
#      JSONB) must NEVER appear in application logs. hono/logger is configured
#      to emit method+path+status only (see src/index.ts). Do NOT add any
#      logger that includes body, query parameters with content, or the Prisma
#      'query' log level.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Database ────────────────────────────────────────────────────────────────
# Local: point at the compose Postgres (host port 5435, 'estimai' database).
# Production (Railway): use the Railway-provisioned Postgres URL (Railway EU).
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/estimai

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (no wildcards).
# Must include the UI origin(s) for each environment.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Auth (JWT resource-server verification) ─────────────────────────────────
# auth service JWKS endpoint — used by jwtMiddleware to verify RS256 tokens.
# Both values are required; the service will refuse to start if either is missing.
#
# IMPORTANT: use /auth/jwks (better-auth's built-in JWKS endpoint) NOT
# /.well-known/jwks.json — the latter serves the env-var key (kid:
# operai-auth-rs256-v1) which is a DIFFERENT key from the one better-auth's
# jwt plugin uses (stored in the jwks table, dynamic kid). The /auth/token
# endpoint signs with the DB keypair, so estimai-api must verify against
# /auth/jwks.
AUTH_JWKS_URL=http://localhost:3001/auth/jwks
AUTH_ISSUER=http://localhost:3001

# Suite-wide JWT audience (ADR-0010). Must exactly match the `audience` claim
# the auth service stamps via its jwt plugin's definePayload hook — a mismatch
# (or a token that predates the claim) is rejected with 401. Treat this as a
# single suite-wide constant, documented identically in auth/.env.example and
# every resource server's .env.example (estimai-api, notify-api), not a
# per-service bespoke value (until per-service audience scoping, see ADR-0010
# Option B follow-up).
AUTH_AUDIENCE=operai-suite

# ─── Size guard ───────────────────────────────────────────────────────────────
# Added by T5 — per-estimate content size cap. Default: 1048576 (1 MiB).
# MAX_ESTIMATE_BYTES=1048576
#
# Added by OWASP fix — bulk-import raw body limit. If unset, defaults to:
#   min(MAX_ESTIMATE_BYTES × 200 + 64 KiB, 32 MiB) = 32 MiB (for the 1 MiB default).
# This gives each of the 200 elements room for the per-element 1 MiB cap plus a
# small envelope. The 32 MiB absolute ceiling is the DoS trade-off: the service is
# internal/behind-auth so a generous-but-bounded ceiling is acceptable.
# Override only if you intentionally raise MAX_ESTIMATE_BYTES.
# MAX_IMPORT_REQUEST_BYTES=33554432

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
