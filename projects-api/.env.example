# projects-api — local environment (specs/024-projects, ADR-0075/0076).
# Copy to .env and fill in. Never commit the filled-in copy.

# ─── Database ─────────────────────────────────────────────────────────────────
# Shared local Postgres (compose.yaml, host port 5435), logical database `projects`.
# The test suite uses `projects_test` (see compose.yaml for the one-time setup).
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/projects

# ─── HTTP ─────────────────────────────────────────────────────────────────────
# The browser calls projects-api from the SHELL's origin (the projects remote runs
# inside it), so :5173 is required; add :5180 only to run projects-ui standalone.
ALLOWED_ORIGINS=http://localhost:5173
PORT=8085
NODE_ENV=development

# ─── Identity (JWKS resource server, ADR-0005/0010/0014) ──────────────────────
# Same values as crm-api.
AUTH_JWKS_URL=http://localhost:3001/auth/jwks
AUTH_ISSUER=http://localhost:3001
AUTH_AUDIENCE=<same as crm-api AUTH_AUDIENCE>
AUTH_BASE_URL=http://localhost:3001

# ─── crm-api, read with a service credential (ADR-0076) ───────────────────────
# All three or none. Without them the service starts, company names read as null
# and the company picker answers 503 crm_unavailable.
# auth needs the matching SERVICE_CLIENTS entry, scope EXACTLY crm.companies.read:
#   "projects-api":{"secret":"<same secret>","scope":"crm.companies.read"}
# and crm-api needs SERVICE_AUDIENCE equal to auth's.
CRM_INTERNAL_URL=http://localhost:8084
SERVICE_CLIENT_ID=projects-api
SERVICE_CLIENT_SECRET=<random, at least 32 characters: openssl rand -hex 32>
