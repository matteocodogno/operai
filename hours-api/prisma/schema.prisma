generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Data model of specs/20261112-time-tracking (plan.md § Data model, ADR 20261112-hours-api-time-entries-own-service-hours-catalog). A time entry is one
// person's duration on one day, on exactly one of a project, a deal, a meeting or no entity. The
// project, deal, meeting and activity ids are opaque ids in other services' databases (no foreign
// key across services); the person is the opaque `auth` user id of the JWT `sub`, never client
// input. Names are resolved live from the owners and from `auth` (ADR 20260807-live-identity-resolution-by-id-fail-soft), never stored here.
// Ids are text cuids, except the seeded list rows, which have the fixed ids of the plan.
//
// Raw SQL in the initial migration, the ENFORCEMENT and not a duplicate (Prisma cannot express
// CHECKs or expression indexes), proved by src/db.constraints.test.ts:
//   time_entry  time_entry_minutes          30..1440 in steps of 30 (AC-1.2)
//               time_entry_note_length      a note is at most 1000 characters (AC-1.7)
//               time_entry_target_shape     exactly the target's columns; a category only on `none`,
//                                           and `none` and `meeting` carry no work type (AC-2.1, AC-3.5)
//               time_entry_activity_target  an activity pointer only on a project or deal entry (AC-2.7)
//   time_category / work_type  a name is unique case-insensitively, per list for work types,
//                              retired rows included (unique indexes on lower(name))
// `onDelete: Restrict` backs "nobody can delete a category or work type" at the database (AC-3.2).
// The rules that need another row or another service (the work type's list matches the target,
// the activity belongs to the same project or deal, no retired item on a create or change, a
// category that requires a note, no future day) stay application checks.
// The migration also inserts the initial lists (A15, AC-3.7) with fixed ids.
//
// specs/20261112-meeting-hours (plan.md § Data model "hours-api", ADR 20261124-a-system-written-time-entry-follows-its-source-fact-only-until-its-person-changes-it-and-is-never-written-again-after-the-person-removed-it):
// the second migration, `meeting_hours`, adds the columns and tables below. Its raw SQL, proved by
// src/db.constraints.test.ts and src/migration.seed.test.ts:
//   time_entry  time_entry_origin_shape   origin = meeting exactly when a source meeting is remembered
//               time_entry_follows_shape  only an automatic entry still on its meeting, with no note, follows it
//               time_entry_one_automatic_per_meeting   partial unique index (userId, sourceMeetingId):
//                                         one automatic entry per person and meeting, ever (AC-4.2)
//   meeting_hours_meeting  seq >= 0       meeting_hours_release  id = 1, one row, written by the migration

enum TimeTarget {
  project
  deal
  meeting
  none
}

enum WorkTypeList {
  project
  deal
}

/// Who wrote a time entry (specs/20261112-meeting-hours): the person, or Operai from a meeting's facts.
enum TimeEntryOrigin {
  person
  meeting
}

/// Why a person is never given an automatic entry on a meeting (AC-1.4, AC-2.5).
enum MeetingHoursBlockReason {
  had_entry
  deleted
}

model TimeEntry {
  id              String          @id @default(cuid())
  /// The JWT `sub` of its creator, never client input (AC-1.1, AC-1.6).
  userId          String
  day             DateTime        @db.Date
  /// 30..1440, a multiple of 30 (CHECK time_entry_minutes). A duration only, never a start or an
  /// end time (AC-1.8).
  minutes         Int
  target          TimeTarget
  /// projects-api id (no FK: another service); set only on a `project` entry (CHECK)
  projectId       String?
  /// crm-api id; set only on a `deal` entry (CHECK)
  dealId          String?
  /// meetings-api id; set only on a `meeting` entry (CHECK). The deal a meeting counts for is
  /// read live, never stored here (AC-2.6).
  meetingId       String?
  /// set only on a `none` entry (CHECK)
  categoryId      String?
  category        TimeCategory?   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// optional; never on a `meeting` or `none` entry (CHECK). Whether it comes from the list that
  /// matches the target is an application check.
  workTypeId      String?
  workType        WorkType?       @relation(fields: [workTypeId], references: [id], onDelete: Restrict)
  /// activities-api id; only on a project or deal entry (CHECK). Shown only while the activity
  /// still exists; never cleared by a read or a write (D47).
  activityId      String?
  /// <= 1000 characters (CHECK time_entry_note_length)
  note            String?
  /// `meeting` for an entry Operai recorded from a meeting's facts, `person` for every other one,
  /// every entry that existed before the feature included. Never changed once written, and the
  /// person's own PATCH keeps it (AC-2.3).
  origin          TimeEntryOrigin @default(person)
  /// The meeting an automatic entry was recorded for, remembered even once its person moved the
  /// entry elsewhere. Set exactly when `origin` is `meeting` (CHECK time_entry_origin_shape);
  /// one entry per person and meeting (partial unique index time_entry_one_automatic_per_meeting).
  sourceMeetingId String?
  /// True while the entry still follows its meeting: written by Operai and not changed by its
  /// person since. Cleared by any saved change of the person (A39); only a following entry can be
  /// moved, resized or removed by a later notice (AC-3.1..3.5). CHECK time_entry_follows_shape.
  followsMeeting  Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId, day])
  @@index([projectId, day])
  @@index([dealId, day])
  @@index([meetingId])
  @@map("time_entry")
}

model TimeCategory {
  id           String      @id @default(cuid())
  /// Shown exactly as typed in both languages (AC-3.8). Unique case-insensitively
  /// (unique index on lower("name"), in the migration).
  name         String
  requiresNote Boolean     @default(false)
  /// null = active; set by retire, cleared by restore (D38)
  retiredAt    DateTime?
  createdBy    String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  entries      TimeEntry[]

  @@map("time_category")
}

model WorkType {
  id        String       @id @default(cuid())
  list      WorkTypeList
  /// Unique case-insensitively within a list (unique index on ("list", lower("name")), in the
  /// migration).
  name      String
  /// as TimeCategory.retiredAt
  retiredAt DateTime?
  createdBy String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  entries   TimeEntry[]

  @@map("work_type")
}

/// The newest version of a meeting's facts applied (specs/20261112-meeting-hours D-P1). The row
/// is also the lock that serialises every apply of one meeting. No foreign key: the meeting is
/// meetings-api's.
model MeetingHoursMeeting {
  meetingId String    @id
  /// >= 0 (CHECK); 0 until a first notice is applied.
  seq       Int
  appliedAt DateTime?

  @@map("meeting_hours_meeting")
}

/// A person who must never get an automatic entry on a meeting: they already had an entry of their
/// own when its duration became known (AC-1.4), or deleted theirs (AC-2.5). No foreign key
/// (other services' ids); written by Operai, never by a client.
model MeetingHoursBlock {
  meetingId String
  userId    String
  reason    MeetingHoursBlockReason
  createdAt DateTime                @default(now())

  @@id([meetingId, userId])
  @@map("meeting_hours_block")
}

/// The release day (AC-1.5): ONE row, `id = 1` (CHECK), written by the migration as the
/// Europe/Zurich date it ran, never by configuration. A meeting whose day is before `since`
/// records no automatic entry.
model MeetingHoursRelease {
  id    Int      @id @db.SmallInt
  since DateTime @db.Date

  @@map("meeting_hours_release")
}
